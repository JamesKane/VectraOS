SESSION := [?]u8{0xdd, 0x70, 0x8f, 0x6f, 0xa1, 0xed, 0x65, 0x11, 0x4d, 0x68, 0xd2, 0x34, 0x3e, 0x7c, 0x2f, 0x1d}
