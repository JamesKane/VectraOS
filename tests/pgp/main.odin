/*
pgptest -- RFC 9580's test vectors through `sys/libpgp`, from ring 3.

The kernel's self-test spawns this and reads the word it exits with: `ok`,
or the name of the first step that did not hold. The RFC's sample version
6 certificate parses to its two keys with the fingerprints the RFC prints,
and both of its signatures verify. The sample secret key parses to its
secret material. The sample X25519-AEAD-OCB message opens to `Hello,
world!` with that key, and a byte of it flipped does not. The sample
inline-signed message verifies against the certificate. That is
`docs/WEB.md` step 3's "RFC 9580's vectors seal and open through libpgp",
the opening half.
*/
package pgptest

import "vsys:abi"
import "vsys:libauth"
import "vsys:libcrypto"
import "vsys:libpgp"
import "vsys:libuser"

fail :: proc "contextless" (what: string) -> ! {
	libuser.exits(what)
}

want :: proc "contextless" (cond: bool, what: string) {
	if !cond {
		fail(what)
	}
}

// Appendix A.3, A.4, A.8.5 and A.7 of RFC 9580, their armor removed.
CERT := [?]u8{0xc6, 0x2a, 0x06, 0x63, 0x87, 0x7f, 0xe3, 0x1b, 0x00, 0x00, 0x00, 0x20, 0xf9, 0x4d, 0xa7, 0xbb, 0x48, 0xd6, 0x0a, 0x61, 0xe5, 0x67, 0x70, 0x6a, 0x65, 0x87, 0xd0, 0x33, 0x19, 0x99, 0xbb, 0x9d, 0x89, 0x1a, 0x08, 0x24, 0x2e, 0xad, 0x84, 0x54, 0x3d, 0xf8, 0x95, 0xa3, 0xc2, 0xb1, 0x06, 0x1f, 0x1b, 0x0a, 0x00, 0x00, 0x00, 0x42, 0x05, 0x82, 0x63, 0x87, 0x7f, 0xe3, 0x03, 0x0b, 0x09, 0x07, 0x05, 0x15, 0x0a, 0x0e, 0x08, 0x0c, 0x02, 0x16, 0x00, 0x02, 0x9b, 0x03, 0x02, 0x1e, 0x09, 0x22, 0x21, 0x06, 0xcb, 0x18, 0x6c, 0x4f, 0x06, 0x09, 0xa6, 0x97, 0xe4, 0xd5, 0x2d, 0xfa, 0x6c, 0x72, 0x2b, 0x0c, 0x1f, 0x1e, 0x27, 0xc1, 0x8a, 0x56, 0x70, 0x8f, 0x65, 0x25, 0xec, 0x27, 0xba, 0xd9, 0xac, 0xc9, 0x05, 0x27, 0x09, 0x02, 0x07, 0x02, 0x00, 0x00, 0x00, 0x00, 0xad, 0x28, 0x20, 0x10, 0x3e, 0x2d, 0x7d, 0x22, 0x7e, 0xc0, 0xe6, 0xd7, 0xce, 0x44, 0x71, 0xdb, 0x36, 0xbf, 0xc9, 0x70, 0x83, 0x25, 0x36, 0x90, 0x27, 0x14, 0x98, 0xa7, 0xef, 0x05, 0x76, 0xc0, 0x7f, 0xaa, 0xe1, 0x45, 0x85, 0xb3, 0xb9, 0x03, 0xb0, 0x12, 0x7e, 0xc4, 0xfd, 0xa2, 0xf0, 0x23, 0x04, 0x5a, 0x2e, 0xc7, 0x6b, 0xcb, 0x4f, 0x95, 0x71, 0xa9, 0x65, 0x1e, 0x14, 0xae, 0xe1, 0x13, 0x7a, 0x1d, 0x66, 0x84, 0x42, 0xc8, 0x8f, 0x95, 0x1e, 0x33, 0xc4, 0xff, 0xd3, 0x3f, 0xb9, 0xa1, 0x7d, 0x51, 0x1e, 0xed, 0x75, 0x8f, 0xc6, 0xd9, 0xcc, 0x50, 0xcb, 0x5f, 0xd7, 0x93, 0xb2, 0x03, 0x9d, 0x58, 0x04, 0xce, 0x2a, 0x06, 0x63, 0x87, 0x7f, 0xe3, 0x19, 0x00, 0x00, 0x00, 0x20, 0x86, 0x93, 0x24, 0x83, 0x67, 0xf9, 0xe5, 0x01, 0x5d, 0xb9, 0x22, 0xf8, 0xf4, 0x80, 0x95, 0xdd, 0xa7, 0x84, 0x98, 0x7f, 0x2d, 0x59, 0x85, 0xb1, 0x2f, 0xba, 0xd1, 0x6c, 0xaf, 0x5e, 0x44, 0x35, 0xc2, 0x9b, 0x06, 0x18, 0x1b, 0x0a, 0x00, 0x00, 0x00, 0x2c, 0x05, 0x82, 0x63, 0x87, 0x7f, 0xe3, 0x02, 0x9b, 0x0c, 0x22, 0x21, 0x06, 0xcb, 0x18, 0x6c, 0x4f, 0x06, 0x09, 0xa6, 0x97, 0xe4, 0xd5, 0x2d, 0xfa, 0x6c, 0x72, 0x2b, 0x0c, 0x1f, 0x1e, 0x27, 0xc1, 0x8a, 0x56, 0x70, 0x8f, 0x65, 0x25, 0xec, 0x27, 0xba, 0xd9, 0xac, 0xc9, 0x00, 0x00, 0x00, 0x00, 0x04, 0x01, 0x20, 0xa6, 0xe9, 0x18, 