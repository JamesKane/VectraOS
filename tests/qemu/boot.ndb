# tests/qemu/boot.ndb: M1's exit test (docs/04 §5). The kernel boots and
# reports itself, then svcd, the first user task, shows that syscalls, ports
# with deadlines, self-posts and VMO mappings work.

scenario=boot timeout=10
expect="vx: kernel 0.1.0 $arch, "
expect="svcd: hello from user space (task 1)"
expect="svcd: port deadline wait ok: requested 10.000 ms, woke after "
expect="svcd: self-post ok"
expect="svcd: vmo map ok"
fail="vx: panic"
fail="killed"
fail="FAILED"
