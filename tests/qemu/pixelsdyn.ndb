# tests/qemu/pixelsdyn.ndb: libvxui.so (M7 step 7g2a, ADR-0056): pixels'
# program as an SDK app, dynamic on libvx.so and libvxui.so
# (tests/user/pixelsdyn.c), matched against pixels' own screen.

scenario=pixelsdyn display=fb timeout=60 cmdline="vx.display vx.desktop" with=pixelsdyn
expect="pixelsdyn: 30 frames, 0 wrong ages"
screen=pixels-$arch tolerance=1
prompt="% "
send="echo do''ne"
expect="done"
fail="vx: panic"
fail="svcd: pixelsdyn exited"
fail="svcd: winsrv exited"
