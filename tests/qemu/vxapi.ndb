# tests/qemu/vxapi.ndb: libvx v0's public API (M6 step 6e4b, ADR-0004): a
# native program built against <vx.h> in the sysroot, linked dynamically,
# its calls answered by libvx.so.

scenario=vxapi timeout=60 cmdline=vx.skip=rc with=vxapitest
expect="vxapitest: hello from <vx.h>"
expect="vxapitest: printed by vx_printf"
expect="vxapitest: child ok"
expect="vxapitest: sleeper waiting"
expect="vxapitest: 40 checks, 0 failed"
line="svcd: vxapitest exited"
fail="vx: panic"
fail="vxapitest: FAILED"
fail="svcd: vxapitest exited: "
fail="vxapitest: child FAILED"
