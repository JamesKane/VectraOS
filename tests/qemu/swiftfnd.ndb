# tests/qemu/swiftfnd.ndb: Swift on VectraOS, stage C (M6 step 6e3c, ADR-0034;
# swift-on-vectra's S8): swiftfnd, built by swift-on-vectra's tests/build.sh
# against its FoundationEssentials (EXTERNAL_PROGRAMS in build.c), on a
# vx-fs volume at /tmp: a file written atomically and read back as Data, a
# JSON round trip, FileManager listing, attributes, a symbolic link,
# subpaths, copy, move and removal, and Date in UTC, all over libvx with no
# POSIX (tests/user/swiftfnd.ndb).

scenario=swiftfnd timeout=90 cmdline=vx.skip=rc with=swiftfnd,fsdvol disk=64 volume=tests/fsd/home
expect="fsd: serving /srv/fsd"
expect="swiftfnd: hello from FoundationEssentials on VectraOS, pid "
expect=" checks, 0 failed"
line="svcd: swiftfnd exited"
fail="vx: panic"
fail="swiftfnd: FAILED"
fail="svcd: swiftfnd exited: "
