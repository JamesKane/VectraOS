# tests/user/ctestfsd.ndb: ctest with /tmp on fsd (tests/qemu/fsd.ndb). partd
# serves the test disk's system partition, which ./build made a vx-fs volume
# (volume=, its home branch tests/fsd/home); fsd mounts it and serves it at
# /srv/fsd; ctest runs as in the posix scenario but with fsd's home branch on
# /tmp. Crash dumps still go to tmpfs (procfs writes them there), mounted on
# /n for ctest to find them. The services start in this order, so the mounts
# ctest's namespace makes find their servers.

service=partd program=/boot/bin/partd console
connect=disk1
claim=disk1.vectra
part=disk1.vectra name=vectra

service=fsd program=/boot/bin/fsd post=fsd console entropy
connect=disk1.vectra

service=ctestfsd program=/boot/bin/ctestfsd console entropy
arg=one
arg="two words"
env=GREETING=hello
ns=posix
mount=/tmp srv=fsd aname=home flags=c
mount=/n srv=tmpfs flags=c
connect=nsd
env=PATH=/bin
env=HOME=/tmp
env=TMPDIR=/tmp
env=CTEST_CRASH=/n/crash
env=CTEST_SELF=/boot/bin/ctestfsd
env=CTEST_FILE=/tmp/hello.txt
