# web.rc: a TLS 1.3 connection across this machine's own stack, run by rc
# from the boot self-test. `tlssrv` announces a port and answers one handshake
# with the certificate in /lib/tls/roots; `tlsclient` dials it by this
# machine's name (which the certificate names), verifies the chain against the
# store and the clock, sends a line, and prints the answer. The exit word is
# `ok` when the line came back through the server, or what went wrong.
host=`{cat /net/sysname}
tlssrv 4433 &
srv=$apid
# Dial once the port is announced: a conversation's `local` names it.
while(! ~ `{cat /net/tcp/[0-9]*/local} *'!4433') sleep 1
got=`{echo hello over tls | tlsclient $host 4433}
wait $srv
s=$status
if(! ~ $s ok) exit $s
if(~ $"got 'you said: hello over tls') exit ok
echo '   web: got' $got
exit mismatch
