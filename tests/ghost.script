# The stub's replies for docs/GHOST.md step 1's boot line: the sandbox
# checks, their control, and `ask`. One modelfs answers every request the
# check makes, in this order, so the order here is the check's.
#
# The sandbox session, one turn. Two writes in one reply: one inside
# /n/work, which lands, and one outside it, which is refused. Both results
# go back in one message.
{"type": "message_start", "message": {"role": "assistant", "model": "stub"}}
{"type": "content_block_start", "index": 0, "content_block": {"type": "tool_use", "id": "w1", "name": "write", "input": {}}}
{"type": "content_block_delta", "index": 0, "delta": {"type": "input_json_delta", "partial_json": "{\"path\": \"/n/work/note\", "}}
{"type": "content_block_delta", "index": 0, "delta": {"type": "input_json_delta", "partial_json": "\"text\": \"hello\"}"}}
{"type": "content_block_stop", "index": 0}
{"type": "content_block_start", "index": 1, "content_block": {"type": "tool_use", "id": "w2", "name": "write", "input": {}}}
{"type": "content_block_delta", "index": 1, "delta": {"type": "input_json_delta", "partial_json": "{\"path\": \"/lib/note\", \"text\": \"x\"}"}}
{"type": "content_block_stop", "index": 1}
{"type": "message_delta", "delta": {"stop_reason": "tool_use"}}
{"type": "message_stop"}
==
