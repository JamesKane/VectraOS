{"type": "content_block_start", "index": 0, "content_block": {"type": "tool_use", "id": "r1", "name": "run", "input": {}}}
{"type": "content_block_delta", "index": 0, "delta": {"type": "input_json_delta", "partial_json": "{\"script\": \"curl http://example.com/\"}"}}
{"type": "content_block_stop", "index": 0}
{"type": "message_delta", "delta": {"stop_reason": "tool_use"}}
{"type": "message_stop"}
