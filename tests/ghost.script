{"type": "content_block_start", "index": 0, "content_block": {"type": "tool_use", "id": "n1", "name": "read", "input": {}}}
{"type": "content_block_delta", "index": 0, "delta": {"type": "input_json_delta", "partial_json": "{\"path\": \"/n/work/note\"}"}}
{"type": "content_block_stop", "index": 0}
{"type": "message_delta", "delta": {"stop_reason": "tool_use"}}
{"type": "message_stop"}
==
# The file changes under the read.
{"type": "message_start", "message": {"role": "assistant", "model": "stub"}}
{"type": "content_block_start", "index": 0, "content_block": {"type": "tool_use", "id": "r2", "name": "run", "input": {}}}
{"type": "content_block_delta", "index": 0, "delta": {"type": "input_json_delta", "partial_json": "{\"script\": \"echo changed > /n/work/note\"}"}}
{"type": "content_block_stop", "index": 0}
{"type": "message_delta", "delta": {"stop_reason": "tool_use"}}
{"type": "message_stop"}
==
