// "VK_EXT_headless_surface";
// device extension "VK_KHR_swapchain"

typedef struct VkVectraWindowSurfaceCreateInfo {
  VkStructureType sType;   // ..._VECTRA_WINDOW_SURFACE_CREATE_INFO
  const void *pNext;
  VkFlags flags;
  const char *pTitle;      // UTF-8
