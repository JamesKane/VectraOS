# SYNOPSIS

```swift
import UICore   // and Themes, which it re-exports

struct Painter {
  init(theme: Theme, fonts: Fonts, scale: Float = 1,
       cache: GlyphCache = GlyphCache())
  var theme: Theme { get }
  var list: DisplayList { get }
  mutating func shape(_ x: Float, _ y: Float, _ width: Float,
                      _ height: Float, _ style: Style)
  var contrast: TextContrast { get }   // the theme's text.contrast
  func render(into canvas: inout Canvas)
}

struct UI {
  init(painter: Painter, width: Float, height: Float)
  mutating func begin(_ input: FrameInput, axis: Axis = .vertical)
  mutating func end()
  mutating func label(_ id: String, _ text: String,
                      class name: String = "label")
  mutating func button(_ id: String, _ text: String,
                       class name: String = "button") -> Bool
  mutating func open(_ id: String, class name: String = "default",
                     width: Size = .children(), ...)
  mutating func close()
  var changed: Bool { get }
}

struct UIQuad { ... }        // 64 bytes, the GPU shader's layout
struct DisplayList { var quads: [UIQuad] ... }
