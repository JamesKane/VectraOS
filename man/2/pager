int64_t pager_create_vmo(uint32_t pager, uint64_t options, uint32_t port,
                         uint64_t key, uint64_t size, uint32_t *out);
/* CROI_SYS_PAGER_DETACH_VMO */
int64_t pager_detach_vmo(uint32_t pager, uint32_t vmo);
/* CROI_SYS_PAGER_SUPPLY_PAGES */
int64_t pager_supply_pages(uint32_t pager, uint32_t vmo, uint64_t offset,
