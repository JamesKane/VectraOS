/* CROI_SYS_PAGER_QUERY_DIRTY_RANGES: pager | vmo << 32 */
int64_t pager_query_dirty_ranges(uint64_t pager_vmo, uint64_t offset,
                                 uint64_t length,
                                 croi_vmo_dirty_range_t *buffer,
                                 uint64_t buffer_size, uint64_t out[2]);
