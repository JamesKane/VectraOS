# SYNOPSIS

```swift
import Settings

enum SettingValue: Equatable, Sendable {
  case int(Int64)
  case bool(Bool)
  case string(String)
  init?(_ a: FsIPC.Attribute)
  init?(_ a: NodeIPC.Attribute)
  func attribute(_ name: String) -> FsIPC.Attribute
  var int: Int64? { get }
  var bool: Bool? { get }
  var string: String? { get }
}

struct Setting: Sendable {
  var area: String
  var name: String
  var label: String
  var fallback: SettingValue
  var range: (Int64, Int64)?
  var choices: [String]
  func accept(_ v: SettingValue?) -> SettingValue
}

enum Settings {
  static let folder: String           // "/data/Settings"
  static let theme: Setting           // Appearance:Theme, "platinum-indigo"
  static let repeatDelay: Setting     // Keyboard:RepeatDelay, 500
  static let repeatRate: Setting      // Keyboard:RepeatRate, 30
  static let pointerSpeed: Setting    // Mouse:Speed, 5
  static let clock24: Setting         // Deskbar:Clock24, true
  static let gauges: Setting          // Deskbar:Gauges, true
  static let all: [Setting]
  static let areas: [String]

  static func read(_ area: String, _ ns: Namespace)
    -> [(name: String, value: SettingValue)]
  static func value(_ s: Setting, _ ns: Namespace) -> SettingValue
  static func set(_ s: Setting, _ v: SettingValue, _ ns: Namespace) -> Bool
  static func touches(_ c: NodeIPC.Change, _ area: String) -> Bool
  static func watch(_ ns: Namespace) -> NodeIPC.NodeClient?
}

enum Grants {
  static let area: String             // "Grants"
  struct Entry: Equatable, Sendable {
    var app: String
    var service: String
    var allowed: Bool
  }
  static func name(_ app: String, _ service: String) -> String
  static func recorded(_ app: String, _ service: String,
                       _ ns: Namespace) -> Bool?
  static func record(_ app: String, _ service: String, _ yes: Bool,
                     _ ns: Namespace) -> Bool
  static func list(_ ns: Namespace) -> [Entry]
  static func revoke(_ app: String, _ service: String, _ ns: Namespace) -> Bool
}

enum Recent {
  static let area: String             // "Recent"
  static let documents: String        // "Recent:Documents"
  static let folders: String          // "Recent:Folders"
  static let apps: String             // "Recent:Apps"
