  case rerror(ename: String)
  case tflush(oldtag: UInt16)
  case rflush
  case twalk(fid: UInt32, newfid: UInt32, names: [String])
  case rwalk(qids: [Qid])
  case topen(fid: UInt32, mode: UInt8)
  case ropen(qid: Qid, iounit: UInt32)
  case tcreate(fid: UInt32, name: String, perm: UInt32, mode: UInt8)
  case rcreate(qid: Qid, iounit: UInt32)
  case tread(fid: UInt32, offset: UInt64, count: UInt32)
  case rread(data: [UInt8])
  case twrite(fid: UInt32, offset: UInt64, data: [UInt8])
  case rwrite(count: UInt32)
  case tclunk(fid: UInt32)
  case rclunk
  case tremove(fid: UInt32)
  case rremove
  case tstat(fid: UInt32)
  case rstat(stat: [UInt8])
  case twstat(fid: UInt32, stat: [UInt8])
  case rwstat
  var type: UInt8 { get }
  var isRequest: Bool { get }
}

struct Message {
  var tag: UInt16
  var fcall: Fcall
  init(tag: UInt16, _ fcall: Fcall)
  func encode() -> [UInt8]?
  static func decode(_ bytes: [UInt8]) -> Message?
  static func size(_ prefix: [UInt8]) -> Int?
}

struct Dir {
  var type: UInt16, dev: UInt32, qid: Qid, mode: UInt32
  var atime: UInt32, mtime: UInt32, length: UInt64
  var name: String, uid: String, gid: String, muid: String
  static var unchanged: Dir { get }
  func encode() -> [UInt8]?
  static func decode(_ bytes: [UInt8]) -> Dir?
  static func decodeAll(_ bytes: [UInt8]) -> [Dir]?
}

enum Version {
  static func answer(_ version: String, msize: UInt32, ours: UInt32,
                     extended: Bool = true) -> (version: String, msize: UInt32)?
  static func dialect(_ version: String) -> String?
}
