vx_status vx_wstat(vx_str path, const vx_dir *d);
vx_dir vx_dir_keep(void);
int64_t vx_dirread(vx_fd fd, vx_arena *a, vx_dir **out);

vx_status vx_remove(vx_str path);
vx_status vx_rename(vx_str from, vx_str to);
vx_status vx_symlink(vx_str target, vx_str path);
