# SYNOPSIS

```c
#include <vx/file.h>

vx_fd vx_open(vx_str path, vx_mode mode);
vx_fd vx_create(vx_str path, vx_mode mode, uint32_t perm);
vx_status vx_close(vx_fd fd);
int64_t vx_read(vx_fd fd, vx_bytes buf);
int64_t vx_write(vx_fd fd, vx_str data);
int64_t vx_pread(vx_fd fd, vx_bytes buf, uint64_t off);
int64_t vx_pwrite(vx_fd fd, vx_str data, uint64_t off);
int64_t vx_seek(vx_fd fd, int64_t off, uint32_t whence);

vx_status vx_stat(vx_str path, vx_arena *a, vx_dir *out);
