# SYNOPSIS

```c
#include <vx/str.h>
#include <vx/fmt.h>

vx_str vx_cstr(const char *s);
bool vx_str_eq(vx_str a, vx_str b);
bool vx_str_prefix(vx_str s, vx_str prefix);
bool vx_str_suffix(vx_str s, vx_str suffix);
vx_str vx_str_cut(vx_str s, size_t from, size_t to);
int64_t vx_str_find(vx_str s, vx_str needle);
bool vx_str_split(vx_str *s, vx_str sep, vx_str *field);
bool vx_str_u64(vx_str s, uint64_t *out);
bool vx_str_i64(vx_str s, int64_t *out);
