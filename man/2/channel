# SYNOPSIS

```c
#include <croi/syscall.h>

/* CROI_SYS_CHANNEL_CREATE */
int64_t channel_create(uint64_t options, uint32_t *out0, uint32_t *out1);
/* CROI_SYS_CHANNEL_WRITE */
int64_t channel_write(croi_channel_write_item_t *items, uint64_t count);
/* CROI_SYS_CHANNEL_READ */
int64_t channel_read(croi_channel_read_item_t *items, uint64_t count);
/* CROI_SYS_CHANNEL_CALL */
int64_t channel_call(uint32_t channel, uint64_t options, uint64_t deadline,
                     croi_channel_call_args_t *args, uint32_t *actual_bytes,
                     uint32_t *actual_handles);

int64_t croi_channel_write(uint32_t channel, uint32_t options,
