{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/runtime-budget.sh\"" }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Bash",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/clean-room-reads.sh\"" }
        ]
      }
    ]
  }
}
