# The Mali-G720's CSF firmware (D164): the image the GPU's microcontroller
# runs, one per GPU architecture. Arm's, under Arm's redistributable
# binary licence (linux-firmware's LICENCE.mali_csffw).
package mali-csf
arch arm64
licence LICENCE.mali_csffw
source Arm's, as linux-firmware ships it; read from FreeBSD's /boot/firmware on the Orange Pi 6 Plus
