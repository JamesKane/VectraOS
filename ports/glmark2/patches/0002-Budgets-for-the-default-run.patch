diff --git a/src/main.cpp b/src/main.cpp
index 3f39e12..64f9df8 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -32,6 +32,9 @@
 #include "benchmark-collection.h"
 #include "scene-collection.h"
