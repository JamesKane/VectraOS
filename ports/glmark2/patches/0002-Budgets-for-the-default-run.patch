+#if GLMARK2_USE_VECTRAOS
+#include "budgets-vectraos.h"
+#endif
 
 #include "canvas-generic.h"
 
@@ -110,7 +113,8 @@ list_scenes()
     }
 }
 
-void
+/* Whether the run met its budgets: VectraOS's; elsewhere there are none. */
+bool
 do_benchmark(Canvas &canvas)
 {
     BenchmarkCollection benchmark_collection;
@@ -128,8 +132,13 @@ do_benchmark(Canvas &canvas)
     Log::info("=======================================================\n");
     Log::info("                                  glmark2 Score: %u \n", loop->score());
     Log::info("=======================================================\n");
+    bool met = true;
+#if GLMARK2_USE_VECTRAOS
+    met = BudgetsVectraOS::finish(loop->score()) == 0;
+#endif
 
     delete loop;
+    return met;
 }
 
 void
@@ -253,12 +262,13 @@ main(int argc, char *argv[])
 
     canvas.visible(true);
 
+    bool met = true;
     if (Options::validate)
         do_validation(canvas);
     else
-        do_benchmark(canvas);
+        met = do_benchmark(canvas);
 
     results_file.end();
 
-    return 0;
+    return met ? 0 : 1;
 }
