@@ -0,0 +1,52 @@
+/*
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ *
+ * This file is part of vkmark, for VectraOS.
+ *
+ * vkmark is free software: you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation, either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * The VectraOS window system: a swapchain on a window of Radharc's
+ * (vectraos_native_system.h). Radharc presents FIFO and nothing else, so a
+ * run asking for mailbox, vkmark's default, gets FIFO; a run asking for
+ * another mode the surface lacks fails as it would elsewhere.
+ */
+
+#include "window_system_plugin.h"
+#include "swapchain_window_system.h"
+#include "vectraos_native_system.h"
+#include "window_system_priority.h"
+
+#include "log.h"
+#include "options.h"
+
+#include <unistd.h>
+
+void vkmark_window_system_load_options(Options&)
+{
+}
+
+int vkmark_window_system_probe(Options const&)
+{
+    /* Radharc's windows are in the namespace of a program whose manifest says 'use windows'. */
+    if (access("/svc/windows", F_OK) == 0)
+        return VKMARK_WINDOW_SYSTEM_PROBE_GOOD + VKMARK_VECTRAOS_WINDOW_SYSTEM_PRIORITY;
+    return VKMARK_WINDOW_SYSTEM_PROBE_BAD;
+}
+
+std::unique_ptr<WindowSystem> vkmark_window_system_create(Options const& options)
+{
+    auto present_mode = options.present_mode;
+    if (present_mode == vk::PresentModeKHR::eMailbox)
+    {
+        Log::info("VectraOSWindowSystemPlugin: Radharc presents FIFO only: using fifo\n");
+        present_mode = vk::PresentModeKHR::eFifo;
+    }
+
+    return std::make_unique<SwapchainWindowSystem>(
+        std::make_unique<VectraOSNativeSystem>(options.size.first, options.size.second),
+        present_mode,
+        options.pixel_format);
+}
