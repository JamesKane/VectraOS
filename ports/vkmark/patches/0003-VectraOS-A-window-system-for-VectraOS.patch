@@ -0,0 +1,163 @@
+/*
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ *
+ * This file is part of vkmark, for VectraOS.
+ *
+ * vkmark is free software: you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation, either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#include "vectraos_native_system.h"
+
+#include "vulkan_state.h"
+#include "log.h"
+
+#include <vulkan_vectra.h>
+
+#include <stdexcept>
+#include <time.h>
+
+namespace
+{
+
+template <typename F>
+F instance_command(vk::Instance instance, char const* name)
+{
+    auto const f = reinterpret_cast<F>(vkGetInstanceProcAddr(instance, name));
+    if (!f)
+        throw std::runtime_error{std::string{"VectraOS window system: the Vulkan layer has no "} + name};
+    return f;
+}
+
+void sleep_ms(long ms)
+{
+    struct timespec const ts{ms / 1000, (ms % 1000) * 1000000};
+    nanosleep(&ts, nullptr);
+}
+
+}
+
+VectraOSNativeSystem::VectraOSNativeSystem(int width, int height)
+    : requested_width{width},
+      requested_height{height},
+      poll_events{nullptr},
+      quit{false},
+      resized{false}
+{
+}
+
+VulkanWSI::Extensions VectraOSNativeSystem::required_extensions()
+{
+    return {{VK_KHR_SURFACE_EXTENSION_NAME, VK_VECTRA_WINDOW_SURFACE_EXTENSION_NAME}, {}};
+}
+
+uint32_t VectraOSNativeSystem::get_presentation_queue_family_index(vk::PhysicalDevice const& pd)
+{
+    /* Every queue family presents to a window of Radharc's. */
+    auto const queue_families = pd.getQueueFamilyProperties();
+
+    for (auto i = 0u; i < queue_families.size(); ++i)
+    {
+        if (queue_families[i].queueCount > 0)
+            return i;
+    }
+
+    return invalid_queue_family_index;
+}
+
+void VectraOSNativeSystem::poll()
+{
+    if (!surface)
+        return;
+
+    auto const poll = reinterpret_cast<PFN_vkPollVectraWindowEventsVECTRA>(poll_events);
+    VkVectraWindowEventVECTRA events[16];
+    VkResult result;
+    do
+    {
+        uint32_t count = 16;
+        result = poll(instance, surface, &count, events);
+        if (result != VK_SUCCESS && result != VK_INCOMPLETE)
+        {
+            quit = true;
+            return;
+        }
+        for (uint32_t i = 0; i < count; ++i)
+        {
+            auto const& e = events[i];
+            if (e.type == VK_VECTRA_WINDOW_EVENT_CLOSE)
+                quit = true;
+            else if (e.type == VK_VECTRA_WINDOW_EVENT_KEY_DOWN && e.keyCode == VK_VECTRA_KEY_ESCAPE)
+                quit = true;
+            else if (e.type == VK_VECTRA_WINDOW_EVENT_RESIZE)
+                resized = true;
+        }
+    } while (result == VK_INCOMPLETE);
+}
+
+bool VectraOSNativeSystem::should_quit()
+{
+    poll();
+    return quit;
+}
+
+vk::Extent2D VectraOSNativeSystem::get_vk_extent()
+{
+    /* The window's size in pixels: its size in points times the output's scale. */
+    return physical_device.getSurfaceCapabilitiesKHR(surface).currentExtent;
+}
+
+ManagedResource<vk::SurfaceKHR> VectraOSNativeSystem::create_vk_surface(VulkanState& vulkan)
+{
+    instance = vulkan.instance();
+    physical_device = vulkan.physical_device();
+
+    auto const fullscreen = requested_width < 0 || requested_height < 0;
+
+    VkVectraWindowSurfaceCreateInfo info{};
+    info.sType = VK_STRUCTURE_TYPE_VECTRA_WINDOW_SURFACE_CREATE_INFO;
+    info.pTitle = "vkmark";
+    info.width = fullscreen ? 800 : static_cast<uint32_t>(requested_width);
+    info.height = fullscreen ? 600 : static_cast<uint32_t>(requested_height);
+
+    auto const create_surface = instance_command<PFN_vkCreateVectraWindowSurface>(
+        instance, "vkCreateVectraWindowSurface");
+
+    VkSurfaceKHR raw = VK_NULL_HANDLE;
+    auto const result = create_surface(instance, &info, nullptr, &raw);
+    if (result != VK_SUCCESS)
+    {
+        throw std::runtime_error{"VectraOS window system: no window of Radharc's (" +
+                                 vk::to_string(static_cast<vk::Result>(result)) +
+                                 "): the manifest must say 'use windows'"};
+    }
+    surface = raw;
+    poll_events = reinterpret_cast<PFN_vkVoidFunction>(instance_command<PFN_vkPollVectraWindowEventsVECTRA>(
+        instance, "vkPollVectraWindowEventsVECTRA"));
+
+    if (fullscreen)
+    {
+        /* The swapchain is made at the size the window has once Radharc has resized it. */
+        auto const set_fullscreen = instance_command<PFN_vkSetVectraWindowFullscreenVECTRA>(
+            instance, "vkSetVectraWindowFullscreenVECTRA");
+        set_fullscreen(instance, surface, VK_TRUE);
+        for (int waited = 0; !resized && !quit && waited < 2000; waited += 10)
+        {
+            poll();
+            if (!resized)
+                sleep_ms(10);
+        }
+        if (!resized)
+            Log::warning("VectraOSNativeSystem: the window did not fill the screen; using its size\n");
+    }
+
+    return ManagedResource<vk::SurfaceKHR>{
+        vk::SurfaceKHR{surface},
+        [this] (vk::SurfaceKHR& s)
+        {
+            instance.destroySurfaceKHR(s);
+            surface = vk::SurfaceKHR{};
+        }};
+}
