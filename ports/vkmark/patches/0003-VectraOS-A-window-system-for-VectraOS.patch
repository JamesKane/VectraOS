+ *
+ * This file is part of vkmark, for VectraOS.
+ *
+ * vkmark is free software: you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation, either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * The native system on VectraOS: a window of Radharc's, VectraOS's
+ * compositor, as a Vulkan surface through the layer's
+ * VK_VECTRA_window_surface (vulkansurface(2) there), presented to through
+ * VK_KHR_swapchain. Its events come from vkPollVectraWindowEventsVECTRA:
+ * closing the window or pressing Escape ends the run.
+ */
+
+#pragma once
+
+#include "native_system.h"
+
+#include <vulkan/vulkan.hpp>
+
+class VectraOSNativeSystem : public NativeSystem
+{
+public:
+    /* A window of width by height points; fullscreen if either is negative. */
+    VectraOSNativeSystem(int width, int height);
+
+    VulkanWSI::Extensions required_extensions() override;
+    uint32_t get_presentation_queue_family_index(vk::PhysicalDevice const& pd) override;
+    bool should_quit() override;
+    vk::Extent2D get_vk_extent() override;
+    ManagedResource<vk::SurfaceKHR> create_vk_surface(VulkanState& vulkan) override;
+
+private:
+    void poll();
+
+    int const requested_width;
+    int const requested_height;
+    vk::Instance instance;
+    vk::SurfaceKHR surface;
+    vk::PhysicalDevice physical_device;
+    PFN_vkVoidFunction poll_events;
+    bool quit;
+    bool resized;
+};
diff --git a/src/ws/vectraos_window_system_plugin.cpp b/src/ws/vectraos_window_system_plugin.cpp
