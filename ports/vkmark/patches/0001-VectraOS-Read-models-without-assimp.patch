+glm::vec3 face_normal(glm::vec3 const& a, glm::vec3 const& b, glm::vec3 const& c)
+{
+    auto const n = glm::cross(b - a, c - a);
+    auto const len = glm::length(n);
+    return len > 0.0f ? n / len : glm::vec3{0.0f, 0.0f, 0.0f};
+}
+
+/* Gives each corner of each triangle its triangle's own normal. */
+void flat_normals(std::vector<Model::Vertex>& vertices)
+{
+    for (size_t i = 0; i + 2 < vertices.size(); i += 3)
+    {
+        auto const n = face_normal(vertices[i].position, vertices[i + 1].position, vertices[i + 2].position);
+        vertices[i].normal = vertices[i + 1].normal = vertices[i + 2].normal = n;
+    }
+}
+
+/* A little-endian reader over a byte buffer that throws when it runs out. */
+class Reader
+{
+public:
+    Reader(char const* data, size_t size) : data{data}, size{size}, pos{0} {}
+
+    bool at_end() const { return pos >= size; }
+    size_t offset() const { return pos; }
+    size_t remaining() const { return size - pos; }
+    void seek(size_t to) { pos = std::min(to, size); }
+
+    void need(size_t n) const
+    {
+        if (n > size - pos)
+            throw std::runtime_error{"Truncated model file"};
+    }
+
+    uint8_t u8() { need(1); return static_cast<uint8_t>(data[pos++]); }
+    uint16_t u16() { auto const lo = u8(); return static_cast<uint16_t>(lo | (u8() << 8)); }
+    uint32_t u32() { auto const lo = u16(); return lo | (static_cast<uint32_t>(u16()) << 16); }
+    float f32() { auto const bits = u32(); float f; std::memcpy(&f, &bits, sizeof f); return f; }
+
+    std::string cstring()
+    {
+        std::string s;
+        while (!at_end())
+        {
+            auto const c = static_cast<char>(u8());
+            if (c == '\0') break;
+            s.push_back(c);
+        }
+        return s;
+    }
+
+private:
+    char const* data;
+    size_t size;
+    size_t pos;
+};
+
+/* The 3DS chunks the loader reads. */
+enum : uint16_t
+{
+    chunk_main = 0x4d4d,
+    chunk_editor = 0x3d3d,
+    chunk_object = 0x4000,
+    chunk_trimesh = 0x4100,
+    chunk_vertices = 0x4110,
+    chunk_faces = 0x4120,
+    chunk_smoothing = 0x4150,
+    chunk_texcoords = 0x4140,
+    chunk_matrix = 0x4160,
+};
+
+struct Mesh3ds
+{
+    std::vector<glm::vec3> positions;
+    std::vector<glm::vec2> texcoords;
+    std::vector<uint16_t> indices; /* three a face */
+    std::vector<uint32_t> smoothing; /* one a face */
+    glm::mat4 matrix{1.0f};
+};
+
+struct PositionKey
+{
+    float x, y, z;
+    bool operator==(PositionKey const& o) const { return x == o.x && y == o.y && z == o.z; }
+};
+
+struct PositionHash
+{
+    size_t operator()(PositionKey const& k) const
+    {
+        uint32_t b[3];
+        std::memcpy(b, &k, sizeof b);
+        return (static_cast<size_t>(b[0]) * 73856093u) ^ (static_cast<size_t>(b[1]) * 19349663u) ^
+               (static_cast<size_t>(b[2]) * 83492791u);
+    }
+};
+
+void read_faces(Reader& r, size_t end, Mesh3ds& mesh)
+{
+    auto const count = r.u16();
+    mesh.indices.reserve(count * 3u);
+    for (auto f = 0u; f < count; ++f)
+    {
+        mesh.indices.push_back(r.u16());
+        mesh.indices.push_back(r.u16());
+        mesh.indices.push_back(r.u16());
+        (void)r.u16(); /* edge flags */
+    }
+    mesh.smoothing.assign(count, 0);
+    while (r.offset() + 6 <= end)
+    {
+        auto const id = r.u16();
+        auto const length = r.u32();
+        auto const next = r.offset() - 6 + length;
+        if (length < 6 || next > end) break;
+        if (id == chunk_smoothing)
+        {
+            for (auto f = 0u; f < count && r.offset() + 4 <= next; ++f)
+                mesh.smoothing[f] = r.u32();
+        }
+        r.seek(next);
+    }
+}
+
+void read_trimesh(Reader& r, size_t end, Mesh3ds& mesh)
+{
+    while (r.offset() + 6 <= end)
+    {
+        auto const id = r.u16();
+        auto const length = r.u32();
+        auto const next = r.offset() - 6 + length;
+        if (length < 6 || next > end) break;
+        switch (id)
+        {
+        case chunk_vertices:
+        {
+            auto const count = r.u16();
+            mesh.positions.reserve(count);
+            for (auto i = 0u; i < count; ++i)
+            {
+                auto const x = r.f32(), y = r.f32(), z = r.f32();
+                mesh.positions.emplace_back(x, y, z);
+            }
+            break;
+        }
+        case chunk_texcoords:
+        {
+            auto const count = r.u16();
+            mesh.texcoords.reserve(count);
+            for (auto i = 0u; i < count; ++i)
+            {
+                auto const u = r.f32(), v = r.f32();
+                mesh.texcoords.emplace_back(u, v);
+            }
+            break;
+        }
+        case chunk_faces:
+            read_faces(r, next, mesh);
+            break;
+        case chunk_matrix:
+        {
+            /* The three axes, then the origin: the columns of an affine matrix. */
+            glm::mat4 m{1.0f};
+            for (auto column = 0; column < 4; ++column)
+                for (auto row = 0; row < 3; ++row)
+                    m[column][row] = r.f32();
+            mesh.matrix = m;
+            break;
+        }
+        default:
+            break;
+        }
+        r.seek(next);
+    }
+}
+
+void read_chunks(Reader& r, size_t end, std::vector<Mesh3ds>& meshes)
+{
+    while (r.offset() + 6 <= end)
+    {
+        auto const id = r.u16();
+        auto const length = r.u32();
+        auto const next = r.offset() - 6 + length;
+        if (length < 6 || next > end) break;
+        switch (id)
+        {
+        case chunk_main:
+        case chunk_editor:
+            read_chunks(r, next, meshes);
+            break;
+        case chunk_object:
+            (void)r.cstring(); /* its name */
+            read_chunks(r, next, meshes);
+            break;
+        case chunk_trimesh:
+            meshes.emplace_back();
+            read_trimesh(r, next, meshes.back());
+            break;
+        default:
+            break;
+        }
+        r.seek(next);
+    }
+}
+
+/* PLY's scalar types, by name. */
+enum class PlyType { none, i8, u8, i16, u16, i32, u32, f32, f64 };
+
+PlyType ply_type(std::string const& name)
+{
+    if (name == "char" || name == "int8") return PlyType::i8;
+    if (name == "uchar" || name == "uint8") return PlyType::u8;
+    if (name == "short" || name == "int16") return PlyType::i16;
+    if (name == "ushort" || name == "uint16") return PlyType::u16;
+    if (name == "int" || name == "int32") return PlyType::i32;
+    if (name == "uint" || name == "uint32") return PlyType::u32;
+    if (name == "float" || name == "float32") return PlyType::f32;
+    if (name == "double" || name == "float64") return PlyType::f64;
+    throw std::runtime_error{"Unknown PLY property type " + name};
+}
+
+struct PlyProperty
+{
+    std::string name;
+    PlyType type;
+    PlyType count_type; /* none: a scalar; else a list */
+};
+
+struct PlyElement
+{
+    std::string name;
+    size_t count;
+    std::vector<PlyProperty> properties;
+};
+
+enum class PlyFormat { ascii, little, big };
+
+class PlyValues
+{
+public:
+    PlyValues(std::vector<char> const& data, size_t start, PlyFormat format)
+        : data{data}, pos{start}, format{format}
+    {
+    }
+
+    double next(PlyType type)
+    {
+        if (format == PlyFormat::ascii)
+        {
+            while (pos < data.size() && std::isspace(static_cast<unsigned char>(data[pos]))) ++pos;
+            auto const begin = pos;
+            while (pos < data.size() && !std::isspace(static_cast<unsigned char>(data[pos]))) ++pos;
+            if (begin == pos)
+                throw std::runtime_error{"Truncated PLY model"};
+            return std::strtod(std::string{data.data() + begin, pos - begin}.c_str(), nullptr);
+        }
+        size_t size = 0;
+        switch (type)
+        {
+        case PlyType::i8: case PlyType::u8: size = 1; break;
+        case PlyType::i16: case PlyType::u16: size = 2; break;
+        case PlyType::i32: case PlyType::u32: case PlyType::f32: size = 4; break;
+        case PlyType::f64: size = 8; break;
+        case PlyType::none: break;
+        }
+        if (size == 0 || size > data.size() - pos)
+            throw std::runtime_error{"Truncated PLY model"};
+        unsigned char b[8];
+        for (size_t i = 0; i < size; ++i)
+            b[i] = static_cast<unsigned char>(data[pos + (format == PlyFormat::little ? i : size - 1 - i)]);
+        pos += size;
+        uint64_t u = 0;
+        for (size_t i = 0; i < size; ++i)
+            u |= static_cast<uint64_t>(b[i]) << (8 * i);
+        switch (type)
+        {
+        case PlyType::i8: return static_cast<int8_t>(u);
+        case PlyType::u8: return static_cast<uint8_t>(u);
+        case PlyType::i16: return static_cast<int16_t>(u);
+        case PlyType::u16: return static_cast<uint16_t>(u);
+        case PlyType::i32: return static_cast<int32_t>(u);
+        case PlyType::u32: return static_cast<uint32_t>(u);
+        case PlyType::f32: { auto const v = static_cast<uint32_t>(u); float f; std::memcpy(&f, &v, 4); return f; }
+        case PlyType::f64: { double d; std::memcpy(&d, &u, 8); return d; }
+        case PlyType::none: break;
+        }
+        return 0;
+    }
+
+private:
+    std::vector<char> const& data;
+    size_t pos;
+    PlyFormat format;
+};
+
+/* A PLY colour channel as 0 to 1: integers are out of their type's largest value. */
+float ply_channel(double v, PlyType type)
+{
+    switch (type)
+    {
+    case PlyType::u8: return static_cast<float>(v / 255.0);
+    case PlyType::u16: return static_cast<float>(v / 65535.0);
+    default: return static_cast<float>(v);
+    }
+}
 
 }
 
