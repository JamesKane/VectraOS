+void Model::load_obj(std::vector<char> const& data)
+{
+    std::vector<glm::vec3> positions, normals;
+    std::vector<glm::vec2> texcoords;
+    bool missing_normals = false;
+    std::istringstream text{std::string{data.begin(), data.end()}};
+    std::string line;
+
+    /* An index as written (1-based, or negative from the end) as 0-based, or -1. */
+    auto resolve = [] (std::string const& s, size_t size) -> long {
+        if (s.empty()) return -1;
+        auto const i = std::stol(s);
+        auto const k = i < 0 ? static_cast<long>(size) + i : i - 1;
+        if (k < 0 || static_cast<size_t>(k) >= size)
+            throw std::runtime_error{"OBJ face indexes past its data"};
+        return k;
+    };
+
+    while (std::getline(text, line))
+    {
+        std::istringstream words{line};
+        std::string word;
+        words >> word;
+        if (word == "v")
+        {
+            glm::vec3 p;
+            words >> p.x >> p.y >> p.z;
+            positions.push_back(p);
+        }
+        else if (word == "vn")
+        {
+            glm::vec3 n;
+            words >> n.x >> n.y >> n.z;
+            normals.push_back(n);
+        }
+        else if (word == "vt")
+        {
+            glm::vec2 t;
+            words >> t.x >> t.y;
+            texcoords.push_back(t);
+        }
+        else if (word == "f")
+        {
+            std::vector<Vertex> corners;
+            std::string corner;
+            bool corner_normals = true;
+            while (words >> corner)
+            {
+                std::string part[3];
+                size_t field = 0;
+                for (auto const c : corner)
                 {
-                    if (texcoords)
-                    {
-                        auto const& texcoord = texcoords[vindex];
-                        mesh->set_attribute(map.texcoord, {texcoord.x, 1.0 - texcoord.y});
-                    }
-                    else
-                    {
-                        mesh->set_attribute(map.texcoord, {0, 0});
-                    }
+                    if (c == '/') { if (++field > 2) break; }
+                    else part[field].push_back(c);
                 }
+                Vertex v{};
+                v.color = glm::vec3{1.0f, 1.0f, 1.0f};
+                v.position = positions.at(static_cast<size_t>(resolve(part[0], positions.size())));
+                auto const t = resolve(part[1], texcoords.size());
+                if (t >= 0) { v.texcoord = texcoords[static_cast<size_t>(t)]; has_texcoords = true; }
+                auto const n = resolve(part[2], normals.size());
+                if (n >= 0) v.normal = normals[static_cast<size_t>(n)];
+                else corner_normals = false;
+                corners.push_back(v);
+            }
+            for (size_t i = 1; i + 1 < corners.size(); ++i)
+            {
+                vertices.push_back(corners[0]);
+                vertices.push_back(corners[i]);
+                vertices.push_back(corners[i + 1]);
             }
+            if (!corner_normals && corners.size() >= 3)
+                missing_normals = true;
+        }
+    }
+
+    if (missing_normals)
+        flat_normals(vertices);
+}
+
+std::unique_ptr<Mesh> Model::to_mesh(ModelAttribMap const& map)
+{
+    auto mesh = std::make_unique<Mesh>(map.formats);
+
+    for (auto const& v : vertices)
+    {
+        mesh->next_vertex();
+
+        if (map.position >= 0)
+            mesh->set_attribute(map.position, glm::vec3{v.position.x, -v.position.y, v.position.z});
+
+        if (map.normal >= 0)
+            mesh->set_attribute(map.normal, glm::vec3{v.normal.x, -v.normal.y, v.normal.z});
+
+        if (map.color >= 0)
+        {
+            if (has_colors)
+                mesh->set_attribute(map.color, v.color);
+            else
+                mesh->set_attribute(map.color, glm::vec3{1, 1, 1});
+        }
+
+        if (map.texcoord >= 0)
+        {
+            if (has_texcoords)
+                mesh->set_attribute(map.texcoord, glm::vec2{v.texcoord.x, 1.0f - v.texcoord.y});
+            else
+                mesh->set_attribute(map.texcoord, glm::vec2{0, 0});
         }
     }
 
