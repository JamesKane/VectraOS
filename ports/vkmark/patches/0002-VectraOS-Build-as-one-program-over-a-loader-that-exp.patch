index a36b299..a6b0766 100644
--- a/src/vulkan_state.cpp
+++ b/src/vulkan_state.cpp
@@ -28,9 +28,42 @@
 #include <vector>
 #include <vulkan/vulkan.hpp>
 
+#if VULKAN_HPP_DISPATCH_LOADER_DYNAMIC
+/* Where the Vulkan library exports only vkGetInstanceProcAddr (VectraOS's
+ * loader), vulkan.hpp's dispatcher asks it for every command: for the
+ * global ones first, then for the instance's and the device's once they
+ * exist. */
+VULKAN_HPP_DEFAULT_DISPATCH_LOADER_DYNAMIC_STORAGE
+#endif
+
 namespace
 {
 
+void init_dispatcher()
+{
+#if VULKAN_HPP_DISPATCH_LOADER_DYNAMIC
+    VULKAN_HPP_DEFAULT_DISPATCHER.init(vkGetInstanceProcAddr);
+#endif
+}
+
+void init_dispatcher(vk::Instance instance)
+{
+#if VULKAN_HPP_DISPATCH_LOADER_DYNAMIC
+    VULKAN_HPP_DEFAULT_DISPATCHER.init(instance);
+#else
+    (void)instance;
+#endif
+}
+
+void init_dispatcher(vk::Device device)
+{
+#if VULKAN_HPP_DISPATCH_LOADER_DYNAMIC
+    VULKAN_HPP_DEFAULT_DISPATCHER.init(device);
+#else
+    (void)device;
+#endif
+}
+
 VKAPI_ATTR VkBool32 VKAPI_CALL debug_callback(
     VkDebugUtilsMessageSeverityFlagBitsEXT message_severity,
     VkDebugUtilsMessageTypeFlagsEXT message_type,
@@ -118,18 +151,29 @@ void VulkanState::log_all_devices()
         .setApiVersion(VK_MAKE_VERSION(1, 0, 0));
 #endif
 
+    init_dispatcher();
+
+    /* The displays, where the instance has VK_KHR_display. */
+    bool have_display = false;
+    for (auto const& e : vk::enumerateInstanceExtensionProperties())
+    {
+        if (strcmp(e.extensionName, VK_KHR_DISPLAY_EXTENSION_NAME) == 0)
+            have_display = true;
+    }
+
     auto const enabled_extensions = std::array<char const*, 2>{
         VK_KHR_SURFACE_EXTENSION_NAME,
         VK_KHR_DISPLAY_EXTENSION_NAME};
 
     auto const create_info = vk::InstanceCreateInfo{}
         .setPApplicationInfo(&app_info)
-        .setEnabledExtensionCount(enabled_extensions.size())
+        .setEnabledExtensionCount(have_display ? enabled_extensions.size() : 0)
         .setPpEnabledExtensionNames(enabled_extensions.data());
 
     auto vk_instance = ManagedResource<vk::Instance>{
         vk::createInstance(create_info),
         [] (auto& i) { i.destroy(); }};
+    init_dispatcher(vk_instance.raw);
 
     auto physical_devices = vk_instance.raw.enumeratePhysicalDevices();
 
@@ -137,6 +181,8 @@ void VulkanState::log_all_devices()
     {
         Log::info("=== Physical Device %d ===\n", i);
         log_device_info(physical_devices[i]);
+        if (!have_display)
+            continue;
         auto const display_props = physical_devices[i].getDisplayPropertiesKHR();
         for (unsigned i = 0; i < display_props.size(); ++i)
         {
@@ -159,6 +205,8 @@ void VulkanState::create_instance(VulkanWSI& vulkan_wsi)
         .setApiVersion(VK_MAKE_VERSION(1, 0, 0));
 #endif
 
+    init_dispatcher();
+
     std::vector<char const*> enabled_extensions{vulkan_wsi.required_extensions().instance};
     std::vector<char const*> validation_layers;
 
@@ -189,6 +237,7 @@ void VulkanState::create_instance(VulkanWSI& vulkan_wsi)
     vk_instance = ManagedResource<vk::Instance>{
         vk::createInstance(create_info),
         [] (auto& i) { i.destroy(); }};
+    init_dispatcher(vk_instance.raw);
 
     if (have_debug_extensions)
     {
@@ -287,6 +336,7 @@ void VulkanState::create_logical_device(VulkanWSI& vulkan_wsi)
     vk_device = ManagedResource<vk::Device>{
         physical_device().createDevice(device_create_info),
         [] (auto& d) { d.destroy(); }};
+    init_dispatcher(vk_device.raw);
 
     vk_graphics_queue = device().getQueue(graphics_queue_family_index(), 0);
 }
