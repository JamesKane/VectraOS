+#ifdef VKMARK_STATIC_WINDOW_SYSTEMS
+/*
+ * Window systems compiled into vkmark, for a system without plugins:
+ * VKMARK_STATIC_WINDOW_SYSTEMS lists them as X(name)..., and each one's
+ * plugin is compiled with its three functions named
+ * vkmark_<name>_window_system_load_options, _probe and _create. They are
+ * probed and chosen as plugins are, by name for --winsys.
+ */
+
+#if defined(__clang__)
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wreturn-type-c-linkage"
+#endif
+
+#define X(ws) \
+    extern "C" void vkmark_##ws##_window_system_load_options(Options&); \
+    extern "C" int vkmark_##ws##_window_system_probe(Options const&); \
+    extern "C" std::unique_ptr<WindowSystem> vkmark_##ws##_window_system_create(Options const&);
+VKMARK_STATIC_WINDOW_SYSTEMS
+#undef X
+
+#if defined(__clang__)
+#pragma clang diagnostic pop
+#endif
