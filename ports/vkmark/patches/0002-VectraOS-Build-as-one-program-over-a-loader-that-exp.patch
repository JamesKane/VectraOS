+struct BuiltInWindowSystem
+{
+    char const* name;
+    VkMarkWindowSystemLoadOptionsFunc load_options;
+    VkMarkWindowSystemProbeFunc probe;
+    VkMarkWindowSystemCreateFunc create;
+};
+
+BuiltInWindowSystem const built_in_window_systems[] = {
+#define X(ws) {#ws, vkmark_##ws##_window_system_load_options, \
+               vkmark_##ws##_window_system_probe, vkmark_##ws##_window_system_create},
+    VKMARK_STATIC_WINDOW_SYSTEMS
+#undef X
+};
+
+BuiltInWindowSystem const* built_in_window_system(std::string const& name)
+{
+    for (auto const& ws : built_in_window_systems)
+    {
+        if (name == ws.name)
+            return &ws;
+    }
+    return nullptr;
+}
+
+void no_lib(void*)
+{
+}
+
+}
+
+WindowSystemLoader::WindowSystemLoader(Options& options)
+    : options{options},
+      lib_handle{nullptr, no_lib}
+{
+}
+
+WindowSystemLoader::~WindowSystemLoader() = default;
+
+WindowSystem& WindowSystemLoader::load_window_system()
+{
+    if (window_system)
+        return *window_system;
+
+    auto const name = options.window_system.empty() ?
+                      probe_for_best_window_system() :
+                      window_system_from_name(options.window_system);
+
+    Log::debug("WindowSystemLoader: Selected window system %s %s\n",
+               name.c_str(),
+               !options.window_system.empty() ? "(user selection)" : "(best match)");
+
+    window_system = built_in_window_system(name)->create(options);
+
+    if (!window_system)
+        throw std::runtime_error{"Selected window system failed to create window system"};
+
+    return *window_system;
+}
+
+std::string WindowSystemLoader::probe_for_best_window_system()
+{
+    std::string best_candidate;
+    int best_priority = 0;
+
+    for (auto const& ws : built_in_window_systems)
+    {
+        auto const priority = ws.probe(options);
+        Log::debug("WindowSystemLoader: Probing %s... succeeded with priority %d\n", ws.name, priority);
+        if (priority > best_priority)
+        {
+            best_candidate = ws.name;
+            best_priority = priority;
+        }
+    }
+
+    if (!best_candidate.empty())
+        return best_candidate;
+
+    throw std::runtime_error{"Failed to find usable window system"};
+}
+
+void WindowSystemLoader::load_window_system_options()
+{
+    for (auto const& ws : built_in_window_systems)
+        ws.load_options(options);
+}
+
+void WindowSystemLoader::for_each_window_system(ForeachCallback const& callback)
+{
+    for (auto const& ws : built_in_window_systems)
+        callback(ws.name, nullptr);
+}
+
+std::string WindowSystemLoader::window_system_from_name(std::string const& name)
+{
+    if (built_in_window_system(name))
+        return name;
+
+    throw std::runtime_error{"Failed to find specified window system '" + name + "'"};
+}
