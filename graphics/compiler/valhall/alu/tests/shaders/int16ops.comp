#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_8bit_storage : require
// int16 and int8 arithmetic, comparison, shifts, division and conversions: twelve results for each element.
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer A { int16_t a[]; };
layout(set = 0, binding = 1) buffer B { int16_t b[]; };
layout(set = 0, binding = 2) buffer R { int16_t r[]; };
layout(set = 0, binding = 3) buffer C { int8_t c[]; };
layout(set = 0, binding = 4) buffer S { int s[]; };
void main() {
  uint i = gl_GlobalInvocationID.x;
  int16_t x = a[i], y = b[i];
  uint16_t ux = uint16_t(x), uy = uint16_t(y);
  r[12 * i + 0] = x + y;
  r[12 * i + 1] = x - y;
  r[12 * i + 2] = x * y;
  r[12 * i + 3] = y == int16_t(0) ? int16_t(0) : x / y;
  r[12 * i + 4] = y == int16_t(0) ? int16_t(0) : x % y;
  r[12 * i + 5] = x >> int16_t(3);
  r[12 * i + 6] = int16_t(ux >> uint16_t(3));
  r[12 * i + 7] = x << int16_t(2);
  r[12 * i + 8] = x < y ? int16_t(1) : int16_t(0);
  r[12 * i + 9] = int16_t(ux < uy ? 1 : 0);
  r[12 * i + 10] = max(x, y);
  r[12 * i + 11] = int16_t(min(ux, uy));
  int8_t p = int8_t(x), q = int8_t(y);
  c[8 * i + 0] = p + q;
  c[8 * i + 1] = p * q;
  c[8 * i + 2] = p >> int8_t(1);
  c[8 * i + 3] = int8_t(uint8_t(p) >> uint8_t(1));
  c[8 * i + 4] = p < q ? int8_t(1) : int8_t(0);
  c[8 * i + 5] = q == int8_t(0) ? int8_t(0) : p / q;
  c[8 * i + 6] = -p;
  c[8 * i + 7] = ~q;
  s[6 * i + 0] = int(x);
  s[6 * i + 1] = int(ux);
  s[6 * i + 2] = int(p);
  s[6 * i + 3] = int(uint8_t(p));
  s[6 * i + 4] = int(int64_t(x) >> 1);
  s[6 * i + 5] = int(float(x));
}
