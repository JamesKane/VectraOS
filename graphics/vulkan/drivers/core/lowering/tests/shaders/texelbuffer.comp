// A uniform texel buffer fetched, and a storage texel buffer written and given an atomic add.
#version 460
layout(local_size_x = 16) in;
layout(set = 0, binding = 0) uniform samplerBuffer src;
layout(set = 0, binding = 1, r32ui) uniform uimageBuffer dst;
layout(set = 0, binding = 2, std430) writeonly buffer Out { vec4 v[]; } o;
void main() {
  uint i = gl_GlobalInvocationID.x;
  o.v[i] = texelFetch(src, int(i));
  imageStore(dst, int(i), uvec4(i * 2u));
  imageAtomicAdd(dst, int(i), 1u);
}
