// A storage image of one dimension and a storage buffer: each texel is read into the buffer (times three, plus its
// index) and then rewritten (plus 100).
#version 460
layout(local_size_x = 16) in;
layout(set = 0, binding = 0, r32ui) uniform uimage1D img;
layout(set = 0, binding = 1, std430) writeonly buffer Out { uint v[]; } o;
void main() {
  uint i = gl_GlobalInvocationID.x;
  uint t = imageLoad(img, int(i)).x;
  o.v[i] = t * 3u + i;
  imageStore(img, int(i), uvec4(t + 100u));
}
