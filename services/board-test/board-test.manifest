# The board image's client (launcher.until=board-test): devmgr's status
# and its drivers' trees at /svc, its disks at /dev, fs's volume at
# /data, and /net as other manifests mount it: devmgr's ether(3)
# directories, then net's protocols.
service board-test
program board-test
use devmgr
use power
use net
mount /dev devmgr/dev
mount /net devmgr/net
mount /net net/net after
mount /data fs/volume create
