# API baseline for todhchai.radharc.Window, written by idlc. Commit it; idlc checks changes against it.
protocol todhchai.radharc.Window version 4
struct Area (Int32,Int32,Int32,Int32)
struct Configure (UInt64,UInt32,UInt32,Bool)
struct Frame (Int64,Int64,Int64,Int64,UInt32)
struct Layer (UInt32,UInt32,Area)
struct Opened (Handle,Handle,Handle,Configure)
enum PixelAlpha UInt8 (0,1,2)
struct PixelTag (Transfer,Primaries,PixelAlpha)
enum Primaries UInt8 (0,1,2)
enum Transfer UInt8 (0,1,2,3)
enum WindowRole UInt8 (0,1)
method addImage call since 1 params (UInt32,Handle,UInt32,UInt32,UInt32,Handle,Handle) result - throws WindowError
method closeRequested event since 1 params () result - throws -
method configure event since 1 params (Configure) result - throws -
method embed call since 1 params (Handle,UInt32,Area) result - throws WindowError
method frame event since 1 params (Frame) result - throws -
method listID call since 3 params () result UInt32 throws -
method moved event since 1 params (Int32,Int32) result - throws -
method openPopup call since 1 params (String,Int32,Int32,UInt32,UInt32) result Opened throws WindowError
method place call since 1 params (Int32,Int32) result - throws WindowError
method placeEmbedding call since 4 params (UInt32,Area) result - throws WindowError
method present call since 1 params (UInt64,UInt32,UInt32,[Layer],[Area],Int64,Int64) result - throws WindowError
method removeImage call since 1 params (UInt32) result - throws -
method setApp call since 1 params (String) result - throws -
method setFullscreen call since 1 params (Bool) result - throws WindowError
method setLatency call since 1 params (UInt32) result - throws WindowError
method setPanel call since 1 params (Bool) result - throws WindowError
method setPopupArea call since 1 params (Int32,Int32,UInt32,UInt32) result - throws WindowError
method setRole call since 1 params (WindowRole) result - throws WindowError
method setTitle call since 1 params (String) result - throws -
method tagImage call since 2 params (UInt32,PixelTag) result - throws WindowError
method unembed call since 1 params (UInt32) result - throws -
method viewGone event since 1 params (UInt32) result - throws -
