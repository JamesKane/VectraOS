# API baseline for todhchai.radharc.Windows, written by idlc. Commit it; idlc checks changes against it.
protocol todhchai.radharc.Windows version 3
struct Area (Int32,Int32,Int32,Int32)
struct WindowEntry (UInt32,String,String,Area,Bool,Bool,Bool)
struct WindowInfo (UInt32,Area,Bool,String)
method changed event since 1 params ([WindowInfo]) result - throws -
method close call since 1 params (UInt32) result - throws WindowError
method entries call since 1 params () result [WindowEntry] throws -
method hidden call since 1 params () result [UInt32] throws -
method hide call since 1 params (UInt32) result - throws WindowError
method list call since 1 params () result [WindowInfo] throws -
method move call since 1 params (UInt32,Int32,Int32) result - throws WindowError
method resize call since 1 params (UInt32,UInt32,UInt32) result - throws WindowError
method show call since 1 params (UInt32) result - throws WindowError
method top call since 1 params (UInt32) result - throws WindowError
method zoom call since 1 params (UInt32) result - throws WindowError
