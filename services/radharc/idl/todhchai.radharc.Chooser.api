# API baseline for todhchai.radharc.Chooser, written by idlc. Commit it; idlc checks changes against it.
protocol todhchai.radharc.Chooser version 10
enum ChooseMode UInt8 (0,1)
struct Configure (UInt64,UInt32,UInt32,Bool)
struct Opened (Handle,Handle,Handle,Configure)
method begin oneway since 1 params (UInt64,Opened,ChooseMode,[String],String,String) result - throws -
method cancel oneway since 1 params (UInt64) result - throws -
method confirm call since 1 params (UInt64) result Handle throws WindowError
