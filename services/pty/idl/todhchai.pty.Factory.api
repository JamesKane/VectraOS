# API baseline for todhchai.pty.Factory, written by idlc. Commit it; idlc checks changes against it.
protocol todhchai.pty.Factory version 1
struct Descriptor (Handle,Handle,Handle,Handle)
struct Opened (Descriptor,Descriptor,Handle)
struct WindowSize (UInt32,UInt32)
method open call since 1 params (WindowSize) result Opened throws PtyError
