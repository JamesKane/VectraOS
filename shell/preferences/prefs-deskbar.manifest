# Deskbar's preferences (preferences(4), D115): a preference app, in Deskbar's
# Preferences submenu, over /data/Settings/Deskbar: its settings,
# written as they change.
service prefs-deskbar
program preferences
env PREFS_AREA=Deskbar
app Deskbar
preferences
export
use windows
mount /data fs/volume
mount /lib/fonts bootfs/lib/fonts
