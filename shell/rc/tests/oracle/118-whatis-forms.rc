fn a { echo one; echo two
	echo three }
fn b { if(~ $1 x) echo yes
if not echo no }
fn c { for(i in 1 2 $*) echo $i | cat }
fn d { while (false) { echo never } }
fn e { x=1 echo $x && ! true || echo 'it''s' }
fn f { echo a^$b $#c $"d $e(1 2) (g h) >/dev/null >>[2]log <in }
fn g { echo `{date}; @{ cd / } }
fn h { cmd >[2=1] >[3=] &; ~ $x *.c }
fn i { echo *.[ch] 'a b' '' }
fn s { switch($1){
case a b
	echo ab
case *
	echo other; echo more
} }
whatis a b c d e f g h i s
