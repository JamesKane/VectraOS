# rio (D75, D107): text windows in Radharc, each running rc with the
# window's files before /dev (rio(4)). Its tree is the windows' files, at
# wsys/N, and its wctl. Each window's rc gets this namespace, in a job of
# its own under `programs`; /proc for their notes. In the desktop's image,
# where tier 1 is built (rio is full Swift, D47).
service rio
program rio
programs
export
use windows
use env
mount /bin bootfs/bin
mount /lib bootfs/lib
mount /lib/fonts bootfs/lib/fonts
mount /lib/man bootfs/lib/man
mount /lib/man fs/volume/lib/man before optional
mount /dev kbdfs
mount /dev mouse after
mount /dev devmgr/dev after
mount /net devmgr/net
mount /net net/net after
mount /net cs/net after
mount /net dns/net after
mount /proc proc
mount /mnt/plumb plumber
mount /dev/kprint console/kprint
mount /data fs/volume create
restart on-failure
