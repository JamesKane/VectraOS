+#ifndef LLVM_CLANG_LIB_DRIVER_TOOLCHAINS_VECTRAOS_H
+#define LLVM_CLANG_LIB_DRIVER_TOOLCHAINS_VECTRAOS_H
+
+#include "Gnu.h"
+#include "clang/Driver/Driver.h"
+#include "clang/Driver/ToolChain.h"
+
+namespace clang {
+namespace driver {
+namespace tools {
+
+/// Links VectraOS's tier 1 programs with ld.lld: static, not position
+/// independent, at croi's user address, entered at crt1.o's _start.
+namespace vectraos {
+class LLVM_LIBRARY_VISIBILITY Linker final : public Tool {
+public:
+  Linker(const ToolChain &TC) : Tool("vectraos::Linker", "ld.lld", TC) {}
+
+  bool hasIntegratedCPP() const override { return false; }
+  bool isLinkJob() const override { return true; }
+
+  void ConstructJob(Compilation &C, const JobAction &JA,
+                    const InputInfo &Output, const InputInfoList &Inputs,
+                    const llvm::opt::ArgList &TCArgs,
+                    const char *LinkingOutput) const override;
+};
+} // end namespace vectraos
+} // end namespace tools
+
+namespace toolchains {
+
+/// The *-vectraos triple: VectraOS's tier 1 programs on croi, a microkernel
+/// with Zircon's object model. Programs reach croi through libsys, with no
+/// POSIX library beneath them; the C library is VectraOS's, ISO C and the
+/// POSIX it chooses. One sysroot, no GCC discovery, no multilib; shared
+/// objects are loaded with dlopen into static programs.
+class LLVM_LIBRARY_VISIBILITY VectraOS : public Generic_ELF {
+public:
+  VectraOS(const Driver &D, const llvm::Triple &Triple,
+         const llvm::opt::ArgList &Args);
+
+  bool HasNativeLLVMSupport() const override { return true; }
+  bool IsMathErrnoDefault() const override { return false; }
+  bool IsObjCNonFragileABIDefault() const override { return true; }
+
+  // Programs are static and not position independent, as VectraOS's own
+  // build links them; shared objects are compiled -fPIC explicitly.
+  bool isPICDefault() const override { return false; }
+  bool isPIEDefault(const llvm::opt::ArgList &Args) const override {
+    return false;
+  }
+  bool isPICDefaultForced() const override { return false; }
+
+  // DWARF 5, the version VectraOS's debug-info reader takes.
+  unsigned GetDefaultDwarfVersion() const override { return 5; }
+
+  const char *getDefaultLinker() const override { return "ld.lld"; }
+  RuntimeLibType GetDefaultRuntimeLibType() const override {
+    return ToolChain::RLT_CompilerRT;
+  }
+  CXXStdlibType GetDefaultCXXStdlibType() const override {
+    return ToolChain::CST_Libcxx;
+  }
+  UnwindTableLevel
+  getDefaultUnwindTableLevel(const llvm::opt::ArgList &Args) const override {
+    return UnwindTableLevel::Asynchronous;
+  }
+
+  void
+  AddClangSystemIncludeArgs(const llvm::opt::ArgList &DriverArgs,
+                            llvm::opt::ArgStringList &CC1Args) const override;
+  void addLibCxxIncludePaths(const llvm::opt::ArgList &DriverArgs,
+                             llvm::opt::ArgStringList &CC1Args) const override;
+  void AddCXXStdlibLibArgs(const llvm::opt::ArgList &Args,
+                           llvm::opt::ArgStringList &CmdArgs) const override;
+
+protected:
+  Tool *buildLinker() const override;
+};
+
+} // end namespace toolchains
+} // end namespace driver
+} // end namespace clang
+
+#endif // LLVM_CLANG_LIB_DRIVER_TOOLCHAINS_VECTRAOS_H
