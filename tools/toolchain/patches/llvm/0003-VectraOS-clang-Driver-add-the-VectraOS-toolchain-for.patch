diff --git a/clang/lib/Driver/ToolChains/VectraOS.cpp b/clang/lib/Driver/ToolChains/VectraOS.cpp
new file mode 100644
index 000000000..9020d1010
--- /dev/null
+++ b/clang/lib/Driver/ToolChains/VectraOS.cpp
@@ -0,0 +1,170 @@
+//===--- VectraOS.cpp - VectraOS ToolChain Implementations --------*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "VectraOS.h"
+#include "clang/Driver/CommonArgs.h"
+#include "clang/Driver/Compilation.h"
+#include "clang/Driver/Options.h"
+#include "llvm/Support/Path.h"
+#include "llvm/Support/VirtualFileSystem.h"
+
+using namespace clang::driver;
+using namespace clang::driver::tools;
+using namespace clang::driver::toolchains;
+using namespace clang;
+using namespace llvm::opt;
+
+void vectraos::Linker::ConstructJob(Compilation &C, const JobAction &JA,
+                                  const InputInfo &Output,
+                                  const InputInfoList &Inputs,
+                                  const ArgList &Args,
+                                  const char *LinkingOutput) const {
+  const auto &ToolChain = static_cast<const VectraOS &>(getToolChain());
+  const Driver &D = ToolChain.getDriver();
+  const bool Shared = Args.hasArg(options::OPT_shared);
+  const bool Relocatable = Args.hasArg(options::OPT_r);
+  ArgStringList CmdArgs;
+
+  // Silence warnings for options that mean nothing to a static link.
+  Args.ClaimAllArgs(options::OPT_g_Group);
+  Args.ClaimAllArgs(options::OPT_emit_llvm);
+  Args.ClaimAllArgs(options::OPT_w);
+  Args.ClaimAllArgs(options::OPT_static);
+  Args.ClaimAllArgs(options::OPT_rdynamic);
+  Args.claimAllArgs(options::OPT_pthread, options::OPT_pthreads);
+
+  if (Args.hasArg(options::OPT_pie))
+    D.Diag(diag::err_drv_unsupported_opt_for_target)
+        << "-pie" << ToolChain.getTriple().str();
+
+  if (!D.SysRoot.empty())
+    CmdArgs.push_back(Args.MakeArgString("--sysroot=" + D.SysRoot));
+
+  // The system's ABI facts: 4 KiB pages, no executable stack, every symbol
+  // bound at load (there is no lazy binding), and a build id, which the
+  // debugger's index keys on. These match how the system links its own
+  // programs.
+  CmdArgs.push_back("--build-id=sha1");
+  CmdArgs.push_back("-z");
+  CmdArgs.push_back("max-page-size=0x1000");
+  CmdArgs.push_back("-z");
+  CmdArgs.push_back("noexecstack");
+  CmdArgs.push_back("-z");
+  CmdArgs.push_back("now");
+
+  if (Relocatable) {
+    CmdArgs.push_back("-r");
+  } else if (Shared) {
+    // A shared object for dlopen (system/ld), which takes libc, libsys and
+    // Sys from the program that loads it: it links nothing by default.
+    CmdArgs.push_back("-shared");
+  } else {
+    // croi's programs: static ET_EXEC at the user address its loaders
+    // place them (userboot and the launcher take ET_EXEC), each segment on
+    // pages of its own, with the stack PT_GNU_STACK asks for. As VectraOS's
+    // tier 0 programs are linked (cmake/croi.cmake).
+    CmdArgs.push_back("-static");
+    CmdArgs.push_back("-e");
+    CmdArgs.push_back("_start");
+    CmdArgs.push_back("--image-base=0x1000000");
+    CmdArgs.push_back("-z");
+    CmdArgs.push_back("separate-loadable-segments");
+    CmdArgs.push_back("-z");
+    CmdArgs.push_back("stack-size=262144");
+  }
+
+  assert((Output.isFilename() || Output.isNothing()) && "Invalid output.");
+  if (Output.isFilename()) {
+    CmdArgs.push_back("-o");
+    CmdArgs.push_back(Output.getFilename());
+  }
+
+  // Tier 1's start file (crt1.o: _start, processargs, the heap and TLS,
+  // in C over croi's calls), first when the sysroot has one.
+  if (!Shared && !Relocatable &&
+      !Args.hasArg(options::OPT_nostdlib, options::OPT_nostartfiles)) {
+    std::string Crt1 = ToolChain.GetFilePath("crt1.o");
+    if (D.getVFS().exists(Crt1))
+      CmdArgs.push_back(Args.MakeArgString(Crt1));
+  }
+
+  Args.addAllArgs(CmdArgs, {options::OPT_L, options::OPT_T_Group,
+                            options::OPT_s, options::OPT_t, options::OPT_u});
+  ToolChain.AddFilePathLibArgs(Args, CmdArgs);
+
+  if (D.isUsingLTO())
+    addLTOOptions(ToolChain, Args, CmdArgs, Output, Inputs,
+                  D.getLTOMode() == LTOK_Thin);
+
+  addLinkerCompressDebugSectionsOption(ToolChain, Args, CmdArgs);
+  AddLinkerInputs(ToolChain, Inputs, Args, CmdArgs, JA);
+
+  // A program's default libraries: libc++ and libc++abi for C++, then
+  // libsys (croi's calls for tier 1) and VectraOS's libc and libm, which
+  // call each other, then compiler-rt's builtins.
+  if (!Shared && !Relocatable &&
+      !Args.hasArg(options::OPT_nostdlib, options::OPT_nodefaultlibs)) {
+    if (D.CCCIsCXX() && ToolChain.ShouldLinkCXXStdlib(Args))
+      ToolChain.AddCXXStdlibLibArgs(Args, CmdArgs);
+    Args.ClaimAllArgs(options::OPT_stdlib_EQ);
+
+    CmdArgs.push_back("--start-group");
+    CmdArgs.push_back("-lsys");
+    CmdArgs.push_back("-lc");
+    CmdArgs.push_back("-lm");
+    CmdArgs.push_back("--end-group");
+    CmdArgs.push_back("-lclang_rt.builtins");
+  }
+
+  const char *Exec = Args.MakeArgString(ToolChain.GetLinkerPath());
+  C.addCommand(std::make_unique<Command>(JA, *this,
+                                         ResponseFileSupport::AtFileCurCP(),
+                                         Exec, CmdArgs, Inputs, Output));
+}
+
+VectraOS::VectraOS(const Driver &D, const llvm::Triple &Triple,
+               const ArgList &Args)
+    : Generic_ELF(D, Triple, Args) {
+  // One sysroot, searched once: no multilib or multiarch directories.
+  getFilePaths().push_back(concat(D.SysRoot, "/usr/lib"));
+}
+
+void VectraOS::AddClangSystemIncludeArgs(const ArgList &DriverArgs,
+                                       ArgStringList &CC1Args) const {
+  const Driver &D = getDriver();
+
+  if (DriverArgs.hasArg(options::OPT_nostdinc))
+    return;
+
+  if (!DriverArgs.hasArg(options::OPT_nobuiltininc)) {
+    SmallString<128> Dir(D.ResourceDir);
+    llvm::sys::path::append(Dir, "include");
+    addSystemInclude(DriverArgs, CC1Args, Dir.str());
+  }
+
+  if (DriverArgs.hasArg(options::OPT_nostdlibinc))
+    return;
+
+  addExternCSystemInclude(DriverArgs, CC1Args,
+                          concat(D.SysRoot, "/usr/include"));
+}
+
+void VectraOS::addLibCxxIncludePaths(const ArgList &DriverArgs,
+                                   ArgStringList &CC1Args) const {
+  addSystemInclude(DriverArgs, CC1Args,
+                   concat(getDriver().SysRoot, "/usr/include/c++/v1"));
+}
+
+void VectraOS::AddCXXStdlibLibArgs(const ArgList &Args,
+                                 ArgStringList &CmdArgs) const {
+  // libc++ and libc++abi, static, with no unwinder.
+  CmdArgs.push_back("-lc++");
+  CmdArgs.push_back("-lc++abi");
+}
+
+Tool *VectraOS::buildLinker() const { return new tools::vectraos::Linker(*this); }
