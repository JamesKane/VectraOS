From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: James Kane <jameskane@ieee.org>
Date: Thu, 11 Jun 2026 14:31:28 -0500
Subject: [PATCH 2/4] [VectraOS] clang: __vectraos__ for the vectraos triple

Adds VectraOSTargetInfo (OSTargets.h), which defines __vectraos__, and
routes Triple::VectraOS to it for aarch64, x86_64 and riscv64
(Targets.cpp). Without it the triple falls through to the bare
per-architecture TargetInfo, with no OS macro for platform branches (the
Swift runtime's, among others) to test. Adapted from swift-on-vectra's
patch for *-vectraos, with riscv64 added.
---
 clang/lib/Basic/Targets.cpp         |  9 +++++++++
 clang/lib/Basic/Targets/OSTargets.h | 16 ++++++++++++++++
 2 files changed, 25 insertions(+)

diff --git a/clang/lib/Basic/Targets.cpp b/clang/lib/Basic/Targets.cpp
index 5d1157889..9a39cf644 100644
--- a/clang/lib/Basic/Targets.cpp
+++ b/clang/lib/Basic/Targets.cpp
@@ -173,6 +173,9 @@ std::unique_ptr<TargetInfo> AllocateTarget(const llvm::Triple &Triple,
     case llvm::Triple::OpenBSD:
       return std::make_unique<OpenBSDTargetInfo<AArch64leTargetInfo>>(Triple,
                                                                       Opts);
+    case llvm::Triple::VectraOS:
+      return std::make_unique<VectraOSTargetInfo<AArch64leTargetInfo>>(Triple,
+                                                                       Opts);
     case llvm::Triple::Win32:
       switch (Triple.getEnvironment()) {
       case llvm::Triple::GNU:
@@ -472,6 +475,9 @@ std::unique_ptr<TargetInfo> AllocateTarget(const llvm::Triple &Triple,
     case llvm::Triple::Managarm:
       return std::make_unique<ManagarmTargetInfo<RISCV64TargetInfo>>(Triple,
                                                                      Opts);
+    case llvm::Triple::VectraOS:
+      return std::make_unique<VectraOSTargetInfo<RISCV64TargetInfo>>(Triple,
+                                                                     Opts);
     default:
       return std::make_unique<RISCV64TargetInfo>(Triple, Opts);
     }
@@ -639,6 +645,9 @@ std::unique_ptr<TargetInfo> AllocateTarget(const llvm::Triple &Triple,
     case llvm::Triple::UEFI:
       return std::make_unique<UEFIX86_64TargetInfo>(Triple, Opts);
 
+    case llvm::Triple::VectraOS:
+      return std::make_unique<VectraOSTargetInfo<X86_64TargetInfo>>(Triple,
+                                                                    Opts);
     case llvm::Triple::Win32: {
       switch (Triple.getEnvironment()) {
       case llvm::Triple::Cygnus:
diff --git a/clang/lib/Basic/Targets/OSTargets.h b/clang/lib/Basic/Targets/OSTargets.h
index 988dea3de..60527f583 100644
--- a/clang/lib/Basic/Targets/OSTargets.h
+++ b/clang/lib/Basic/Targets/OSTargets.h
@@ -945,6 +945,22 @@ public:
   }
 };
 
+// VectraOS target
+template <typename Target>
+class LLVM_LIBRARY_VISIBILITY VectraOSTargetInfo
+    : public OSTargetInfo<Target> {
+protected:
+  void getOSDefines(const LangOptions &Opts, const llvm::Triple &Triple,
+                    MacroBuilder &Builder) const override {
+    Builder.defineMacro("__vectraos__");
+    this->PlatformName = "vectraos";
+  }
+
+public:
+  VectraOSTargetInfo(const llvm::Triple &Triple, const TargetOptions &Opts)
+      : OSTargetInfo<Target>(Triple, Opts) {}
+};
+
 // WebAssembly target
 template <typename Target>
 class LLVM_LIBRARY_VISIBILITY WebAssemblyOSTargetInfo
