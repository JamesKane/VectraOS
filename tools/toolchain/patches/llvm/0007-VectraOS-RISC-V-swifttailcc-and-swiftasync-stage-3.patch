   for (unsigned i = 0, e = Outs.size(); i != e; ++i) {
@@ -22679,10 +22751,22 @@ SDValue RISCVTargetLowering::LowerCall(CallLoweringInfo &CLI,
     if (VA.isRegLoc()) {
       // Queue up the argument copies and emit them at the end.
       RegsToPass.push_back(std::make_pair(VA.getLocReg(), ArgValue));
+    } else if (IsTailCall) {
+      assert(VA.isMemLoc() && "Argument not register or memory");
+      assert(IsSwiftTailCall && "Tail call not allowed if stack is used "
+                                "for passing parameters");
+      MachineFrameInfo &MFI = MF.getFrameInfo();
+      int FI = MFI.CreateFixedObject(VA.getLocVT().getStoreSize(),
+                                     VA.getLocMemOffset() + FPDiff,
+                                     /*IsImmutable=*/false);
+      SDValue FIN = DAG.getFrameIndex(FI, PtrVT);
+      // Incoming arguments it overlaps are loaded before it's stored.
