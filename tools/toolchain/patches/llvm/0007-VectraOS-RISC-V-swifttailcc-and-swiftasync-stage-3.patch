-      assert(!IsTailCall && "Tail call not allowed if stack is used "
-                            "for passing parameters");
 
       // Work out the address of the stack slot.
       if (!StackPtr.getNode())
@@ -22776,6 +22860,15 @@ SDValue RISCVTargetLowering::LowerCall(CallLoweringInfo &CLI,
     MF.getFrameInfo().setHasTailCall();
     unsigned CallOpc =
         NeedSWGuarded ? RISCVISD::SW_GUARDED_TAIL : RISCVISD::TAIL;
+    if (FPDiff != 0) {
+      if (NeedSWGuarded || Subtarget.hasStdExtZicfilp() || CLI.CFIType)
+        reportFatalUsageError("swifttailcc tail calls that move the stack "
+                              "pointer are not supported with Zicfilp or "
+                              "KCFI");
+      CallOpc = RISCVISD::TAIL_SA;
