diff --git a/clang/lib/Basic/Targets/RISCV.cpp b/clang/lib/Basic/Targets/RISCV.cpp
index bd3c4fcc8..7c1b26aea 100644
--- a/clang/lib/Basic/Targets/RISCV.cpp
+++ b/clang/lib/Basic/Targets/RISCV.cpp
@@ -615,7 +615,11 @@ RISCVTargetInfo::checkCallingConvention(CallingConv CC) const {
       return CCCR_Error;
     return CCCR_OK;
   case CC_SwiftAsync:
-    return CCCR_Error;
+    // swifttailcc: swiftasync in x22 and guaranteed tail calls that pop the
+    // callee's stack arguments (VectraOS's series, stage 3).
+    if (ABI == "ilp32e" || ABI == "lp64e")
+      return CCCR_Error;
+    return CCCR_OK;
   }
 }
 
diff --git a/llvm/lib/Target/RISCV/RISCVCallingConv.cpp b/llvm/lib/Target/RISCV/RISCVCallingConv.cpp
index 57b86d343..ebd5d0971 100644
--- a/llvm/lib/Target/RISCV/RISCVCallingConv.cpp
+++ b/llvm/lib/Target/RISCV/RISCVCallingConv.cpp
@@ -381,14 +381,24 @@ bool llvm::CC_RISCV(unsigned ValNo, MVT ValVT, MVT LocVT,
     }
   }
 
+  // A swiftasync context is passed in x22 (s6), callee-saved otherwise, as
+  // AArch64 uses x22. swifttailcc doesn't preserve it (CSR_*_SwiftTail).
+  if (!IsRet && ArgFlags.isSwiftAsync() && LocVT == XLenVT && !IsEABI) {
+    if (MCRegister Reg = State.AllocateReg(RISCV::X22)) {
+      State.addLoc(CCValAssign::getReg(ValNo, ValVT, Reg, LocVT, LocInfo));
+      return false;
+    }
+  }
+
   // Swift returns values directly in up to four registers (a0-a3/fa0-fa3);
   // other conventions return in at most two. This must cover everything
   // clang's SwiftABIInfo::shouldPassIndirectly (limit: four registers)
   // classifies as a direct return. Any return value split in to more values
   // than this can't be returned directly. Vectors are returned via the
   // available vector registers.
-  unsigned MaxDirectRetVals =
-      State.getCallingConv() == CallingConv::Swift && !IsEABI ? 4 : 2;
+  bool IsSwiftCC = State.getCallingConv() == CallingConv::Swift ||
+                   State.getCallingConv() == CallingConv::SwiftTail;
+  unsigned MaxDirectRetVals = IsSwiftCC && !IsEABI ? 4 : 2;
   if (!LocVT.isVector() && IsRet && ValNo >= MaxDirectRetVals)
     return true;
 
diff --git a/llvm/lib/Target/RISCV/RISCVCallingConv.td b/llvm/lib/Target/RISCV/RISCVCallingConv.td
index 8f5ea92e8..bb78c68da 100644
--- a/llvm/lib/Target/RISCV/RISCVCallingConv.td
+++ b/llvm/lib/Target/RISCV/RISCVCallingConv.td
@@ -37,7 +37,19 @@ def CSR_ILP32F_LP64F_SwiftError
 def CSR_ILP32D_LP64D_SwiftError
     : CalleeSavedRegs<(sub CSR_ILP32D_LP64D, X21)>;
 
-defvar CSR_V =(add (sequence "V%u", 1, 7), (sequence "V%u", 24, 31),
+// A swifttailcc function doesn't preserve x20 (swiftself), x21 (swifterror)
+// or x22 (swiftasync): a tail call passes new values in them, which a
+// callee-saved restore before the jump would clobber.
+def CSR_ILP32_LP64_SwiftTail
+    : CalleeSavedRegs<(sub CSR_ILP32_LP64, X20, X21, X22)>;
+
+def CSR_ILP32F_LP64F_SwiftTail
+    : CalleeSavedRegs<(sub CSR_ILP32F_LP64F, X20, X21, X22)>;
+
+def CSR_ILP32D_LP64D_SwiftTail
+    : CalleeSavedRegs<(sub CSR_ILP32D_LP64D, X20, X21, X22)>;
+
+defvar CSR_V = (add (sequence "V%u", 1, 7), (sequence "V%u", 24, 31),
                      V2M2, V4M2, V6M2, V24M2, V26M2, V28M2, V30M2,
                      V4M4, V24M4, V28M4, V24M8);
 
diff --git a/llvm/lib/Target/RISCV/RISCVFrameLowering.cpp b/llvm/lib/Target/RISCV/RISCVFrameLowering.cpp
index c4f41b8d8..b60da9c63 100644
--- a/llvm/lib/Target/RISCV/RISCVFrameLowering.cpp
+++ b/llvm/lib/Target/RISCV/RISCVFrameLowering.cpp
@@ -1188,6 +1188,25 @@ void RISCVFrameLowering::emitEpilogue(MachineFunction &MF,
   if (MF.getFunction().getCallingConv() == CallingConv::GHC)
     return;
 
+  // swifttailcc: once the frame is gone the stack pointer moves by a tail
+  // call's difference in stack arguments (PseudoTAIL*_SA's operand, which then
+  // becomes a plain PseudoTAIL*), or by the incoming stack arguments a return
+  // pops.
+  int64_t ArgStackAdj = 0;
+  if (MachineBasicBlock::iterator Term = MBB.getFirstTerminator();
+      Term != MBB.end()) {
+    unsigned Opc = Term->getOpcode();
+    if (Opc == RISCV::PseudoTAIL_SA || Opc == RISCV::PseudoTAILIndirect_SA) {
+      ArgStackAdj = Term->getOperand(1).getImm();
+      Term->removeOperand(1);
+      Term->setDesc(STI.getInstrInfo()->get(Opc == RISCV::PseudoTAIL_SA
+                                                ? RISCV::PseudoTAIL
+                                                : RISCV::PseudoTAILIndirect));
+    } else if (Term->isReturn() && !Term->isCall()) {
+      ArgStackAdj = RVFI->getArgumentStackToRestore();
+    }
+  }
+
   // Get the insert location for the epilogue. If there were no terminators in
   // the block, get the last instruction.
   MachineBasicBlock::iterator MBBI = MBB.end();
@@ -1338,6 +1357,11 @@ void RISCVFrameLowering::emitEpilogue(MachineFunction &MF,
     deallocateStack(MF, MBB, MBBI, DL, StackSize,
                     RVFI->getQCIInterruptStackSize());
 
+  if (ArgStackAdj != 0)
+    RI->adjustReg(MBB, MBB.getFirstTerminator(), DL, SPReg, SPReg,
+                  StackOffset::getFixed(ArgStackAdj),
+                  MachineInstr::FrameDestroy, getStackAlign());
+
   // Emit epilogue for shadow call stack.
   emitSCSEpilogue(MF, MBB, MBBI, DL);
 
@@ -1790,6 +1814,18 @@ MachineBasicBlock::iterator RISCVFrameLowering::eliminateCallFramePseudoInstr(
     MachineBasicBlock::iterator MI) const {
   DebugLoc DL = MI->getDebugLoc();
 
+  // A swifttailcc callee pops its stack arguments. With a reserved call frame
+  // the stack pointer goes back down by as much; without one, the
+  // ADJCALLSTACKUP adds that much less.
+  int64_t CalleePopAmount =
+      MI->getOpcode() == RISCV::ADJCALLSTACKUP ? MI->getOperand(1).getImm() : 0;
+  if (CalleePopAmount != 0 && hasReservedCallFrame(MF)) {
+    const RISCVRegisterInfo &RI = *STI.getRegisterInfo();
+    RI.adjustReg(MBB, MI, DL, SPReg, SPReg,
+                 StackOffset::getFixed(-CalleePopAmount),
+                 MachineInstr::NoFlags, getStackAlign());
+  }
+
   if (!hasReservedCallFrame(MF)) {
     // If space has not been reserved for a call frame, ADJCALLSTACKDOWN and
     // ADJCALLSTACKUP must be converted to instructions manipulating the stack
@@ -1804,6 +1840,8 @@ MachineBasicBlock::iterator RISCVFrameLowering::eliminateCallFramePseudoInstr(
 
       if (MI->getOpcode() == RISCV::ADJCALLSTACKDOWN)
         Amount = -Amount;
+      else
+        Amount -= CalleePopAmount;
 
       const RISCVTargetLowering *TLI =
           MF.getSubtarget<RISCVSubtarget>().getTargetLowering();
@@ -1852,6 +1890,11 @@ RISCVFrameLowering::getFirstSPAdjustAmount(const MachineFunction &MF) const {
   if (RVFI->getReservedSpillsSize())
     return 0;
 
+  // Nor if a swifttailcc tail call's stack arguments are reserved at the top
+  // of the frame, above the callee-saved registers.
+  if (RVFI->getTailCallReservedStack())
+    return 0;
+
   // Return the FirstSPAdjustAmount if the StackSize can not fit in a signed
   // 12-bit and there exists a callee-saved register needing to be pushed.
   if (!isInt<12>(StackSize) && (CSI.size() > 0)) {
@@ -2249,6 +2292,11 @@ bool RISCVFrameLowering::enableShrinkWrapping(const MachineFunction &MF) const {
   if (MF.getFunction().hasOptNone())
     return false;
 
+  // swifttailcc's epilogue moves the stack pointer by what its block's return
+  // or tail call says, so it belongs in that block.
+  if (MF.getFunction().getCallingConv() == CallingConv::SwiftTail)
+    return false;
+
   return true;
 }
 
