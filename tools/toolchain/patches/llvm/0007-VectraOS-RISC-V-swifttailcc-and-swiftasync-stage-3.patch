diff --git a/llvm/lib/Target/RISCV/RISCVInstrInfo.td b/llvm/lib/Target/RISCV/RISCVInstrInfo.td
index f63531a01..c4822f835 100644
--- a/llvm/lib/Target/RISCV/RISCVInstrInfo.td
+++ b/llvm/lib/Target/RISCV/RISCVInstrInfo.td
@@ -61,6 +61,15 @@ def riscv_tail      : RVSDNode<"TAIL", SDT_RISCVCall,
                                [SDNPHasChain, SDNPOptInGlue, SDNPOutGlue,
                                 SDNPVariadic]>;
 
+// A swifttailcc tail call that moves the stack pointer by its second operand
+// after the epilogue: the caller's incoming stack argument area minus the
+// callee's (RISCVFrameLowering::emitEpilogue).
+def SDT_RISCVTailSA : SDTypeProfile<0, -1, [SDTCisVT<0, XLenVT>,
+                                            SDTCisVT<1, i32>]>;
+def riscv_tail_sa   : RVSDNode<"TAIL_SA", SDT_RISCVTailSA,
+                               [SDNPHasChain, SDNPOptInGlue, SDNPOutGlue,
+                                SDNPVariadic]>;
+
 // Software guarded calls for large code model
 def riscv_sw_guarded_call : RVSDNode<"SW_GUARDED_CALL", SDT_RISCVCall,
                                      [SDNPHasChain, SDNPOptInGlue, SDNPOutGlue,
@@ -1838,6 +1847,22 @@ def : Pat<(riscv_tail (iPTR tglobaladdr:$dst)),
 def : Pat<(riscv_tail (iPTR texternalsym:$dst)),
           (PseudoTAIL texternalsym:$dst)>;
 
+// swifttailcc's tail calls with a stack adjustment. emitEpilogue moves the
+// stack pointer by $spadj and puts PseudoTAIL or PseudoTAILIndirect in their
+// place, so nothing after prologue/epilogue insertion sees these.
+let isCall = 1, isTerminator = 1, isReturn = 1, isBarrier = 1, Uses = [X2],
+    Size = 8 in {
+def PseudoTAIL_SA : Pseudo<(outs), (ins call_symbol:$dst, i32imm:$spadj), []>;
+let Predicates = [NoStdExtZicfilp] in
+def PseudoTAILIndirect_SA : Pseudo<(outs), (ins GPRTC:$rs1, i32imm:$spadj),
+                                   [(riscv_tail_sa GPRTC:$rs1, timm:$spadj)]>;
+}
+
+def : Pat<(riscv_tail_sa (iPTR tglobaladdr:$dst), timm:$spadj),
+          (PseudoTAIL_SA tglobaladdr:$dst, timm:$spadj)>;
+def : Pat<(riscv_tail_sa (iPTR texternalsym:$dst), timm:$spadj),
+          (PseudoTAIL_SA texternalsym:$dst, timm:$spadj)>;
+
 let isCall = 0, isBarrier = 1, isBranch = 1, isTerminator = 1, Size = 8,
     isCodeGenOnly = 0, hasSideEffects = 0, mayStore = 0, mayLoad = 0 in
 def PseudoJump : Pseudo<(outs GPR:$rd), (ins pseudo_jump_symbol:$target), [],
