diff --git a/llvm/test/CodeGen/RISCV/swifttailcc-vectraos.ll b/llvm/test/CodeGen/RISCV/swifttailcc-vectraos.ll
new file mode 100644
index 000000000..e11d8d35f
--- /dev/null
+++ b/llvm/test/CodeGen/RISCV/swifttailcc-vectraos.ll
@@ -0,0 +1,42 @@
+; RUN: llc -mtriple=riscv64 -mattr=+d,+c -target-abi=lp64d -O2 < %s | FileCheck %s
+; Stage 3 (VectraOS series): swifttailcc pops its stack arguments and
+; guarantees tail calls; checked by hand against the asm, CHECK lines to come.
+; CHECK-LABEL: grow:
+; CHECK: addi sp, sp, -16
+; CHECK-NEXT: tail ten
+declare swifttailcc void @ten(ptr swiftasync, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64)
+declare swifttailcc void @one(ptr swiftasync, i64)
+declare void @use(i64)
+
+; pops its two stack args on return
+define swifttailcc i64 @callee10(ptr swiftasync %c, i64 %a, i64 %b, i64 %c3, i64 %d, i64 %e, i64 %f, i64 %g, i64 %h, i64 %i, i64 %j) {
+  call void @use(i64 %j)
+  %r = add i64 %i, %j
+  ret i64 %r
+}
+
+; no stack args in, 2 out: FPDiff = -16
+define swifttailcc void @grow(ptr swiftasync %ctx, i64 %x) {
+  call void @use(i64 %x)
+  musttail call swifttailcc void @ten(ptr swiftasync %ctx, i64 1, i64 2, i64 3, i64 4, i64 5, i64 6, i64 7, i64 %x, i64 9, i64 10)
+  ret void
+}
+
+; 2 stack args in, 0 out: FPDiff = +16
+define swifttailcc void @shrink(ptr swiftasync %ctx, i64 %a, i64 %b, i64 %c3, i64 %d, i64 %e, i64 %f, i64 %g, i64 %h, i64 %i, i64 %j) {
+  musttail call swifttailcc void @one(ptr swiftasync %ctx, i64 %j)
+  ret void
+}
+
+; same shape, swapped stack args: FPDiff = 0, loads before stores
+define swifttailcc void @swap(ptr swiftasync %ctx, i64 %a, i64 %b, i64 %c3, i64 %d, i64 %e, i64 %f, i64 %g, i64 %h, i64 %i, i64 %j) {
+  musttail call swifttailcc void @ten(ptr swiftasync %ctx, i64 %a, i64 %b, i64 %c3, i64 %d, i64 %e, i64 %f, i64 %g, i64 %h, i64 %j, i64 %i)
+  ret void
+}
+
+; a C caller: callee pops 16
+define void @ccaller(ptr %ctx) {
+  call swifttailcc void @ten(ptr swiftasync %ctx, i64 1, i64 2, i64 3, i64 4, i64 5, i64 6, i64 7, i64 8, i64 9, i64 10)
+  call void @use(i64 0)
+  ret void
+}
