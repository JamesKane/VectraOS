From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: James Kane <kanej1973@gmail.com>
Date: Sun, 11 Oct 2026 20:36:17 -0500
Subject: [PATCH 05/14] [VectraOS] the runtime's platform sites

Byte order from the compiler (no <endian.h>); the heap's usable size
through malloc_usable_size (VectraOS's floor has it); random bytes from
getentropy, croi's CPRNG, 256 at a time; CommandLine.arguments from the
floor's argv (td_argv); and Pthreads.cpp's stack bounds unknown where
neither pthread_getattr_np nor pthread_attr_get_np exists (it compiled
pthread_attr_getstack's call regardless).
---
 lib/Threading/Pthreads.cpp                       |  5 +++++
 stdlib/include/llvm/Support/SwapByteOrder.h      |  5 +++++
 stdlib/public/CommandLineSupport/CommandLine.cpp | 11 +++++++++++
 stdlib/public/SwiftShims/swift/shims/LibcShims.h |  3 ++-
 stdlib/public/stubs/Random.cpp                   | 16 ++++++++++++++++
 5 files changed, 39 insertions(+), 1 deletion(-)

diff --git a/lib/Threading/Pthreads.cpp b/lib/Threading/Pthreads.cpp
index 1daa8527..9588f47c 100644
--- a/lib/Threading/Pthreads.cpp
+++ b/lib/Threading/Pthreads.cpp
@@ -111,9 +111,13 @@ swift::threading_impl::thread_get_current_stack_bounds() {
     return {};
 #else
   // We don't know how to get the thread attr for this platform.
+  (void)attr;
+  (void)size;
+  (void)begin;
   return {};
 #endif
 
+#if defined(__FreeBSD__) || defined(__linux__)
   if (!pthread_attr_getstack(&attr, &begin, &size)) {
     stack_bounds result = { begin, (char *)begin + size };
     pthread_attr_destroy(&attr);
@@ -122,6 +126,7 @@ swift::threading_impl::thread_get_current_stack_bounds() {
 
   pthread_attr_destroy(&attr);
   return {};
+#endif
 }
 #endif
 
diff --git a/stdlib/include/llvm/Support/SwapByteOrder.h b/stdlib/include/llvm/Support/SwapByteOrder.h
index 31e77236..5243de99 100644
--- a/stdlib/include/llvm/Support/SwapByteOrder.h
+++ b/stdlib/include/llvm/Support/SwapByteOrder.h
@@ -36,6 +36,11 @@
 #else
 #define BYTE_ORDER LITTLE_ENDIAN
 #endif
+#elif defined(__vectraos__)
+/* No <endian.h> in VectraOS's libc: the compiler says. */
+#define BIG_ENDIAN __ORDER_BIG_ENDIAN__
+#define LITTLE_ENDIAN __ORDER_LITTLE_ENDIAN__
+#define BYTE_ORDER __BYTE_ORDER__
 #elif defined(__MVS__)
 #define BIG_ENDIAN 4321
 #define LITTLE_ENDIAN 1234
diff --git a/stdlib/public/CommandLineSupport/CommandLine.cpp b/stdlib/public/CommandLineSupport/CommandLine.cpp
index 4056e7e7..e018c25c 100644
--- a/stdlib/public/CommandLineSupport/CommandLine.cpp
+++ b/stdlib/public/CommandLineSupport/CommandLine.cpp
@@ -530,6 +530,17 @@ static char **swift::getUnsafeArgvArgc(int *outArgLen) {
   return ps->ps_argvstr;
 }
 
+template <typename F>
+static void swift::enumerateUnsafeArgv(const F& body) { }
+#elif defined(__vectraos__)
+// The floor's argv (VectraOS's libsys), made at start from the processargs
+// message, and kept for the process's life.
+extern "C" char **td_argv(int *argc);
+
+static char **swift::getUnsafeArgvArgc(int *outArgLen) {
+  return td_argv(outArgLen);
+}
+
 template <typename F>
 static void swift::enumerateUnsafeArgv(const F& body) { }
 #else // Add your favorite OS's command line arg grabber here.
diff --git a/stdlib/public/SwiftShims/swift/shims/LibcShims.h b/stdlib/public/SwiftShims/swift/shims/LibcShims.h
index 27060e34..491eeb40 100644
--- a/stdlib/public/SwiftShims/swift/shims/LibcShims.h
+++ b/stdlib/public/SwiftShims/swift/shims/LibcShims.h
@@ -105,7 +105,8 @@ static inline __swift_size_t _swift_stdlib_malloc_size(const void *ptr) {
   return malloc_size(ptr);
 }
 #elif defined(__linux__) || defined(__CYGWIN__) || defined(__ANDROID__) \
-   || defined(__HAIKU__) || defined(__FreeBSD__) || defined(__wasi__)
+   || defined(__HAIKU__) || defined(__FreeBSD__) || defined(__wasi__) \
+   || defined(__vectraos__)
 #define HAS_MALLOC_SIZE 1
 static inline __swift_size_t _swift_stdlib_malloc_size(const void *ptr) {
 #if defined(__ANDROID__)
diff --git a/stdlib/public/stubs/Random.cpp b/stdlib/public/stubs/Random.cpp
index 9062346f..5f33331a 100644
--- a/stdlib/public/stubs/Random.cpp
+++ b/stdlib/public/stubs/Random.cpp
@@ -23,6 +23,8 @@
 #include <Windows.h>
 #include <Bcrypt.h>
 #pragma comment(lib, "bcrypt.lib")
+#elif defined(__vectraos__)
+#include <unistd.h> // getentropy (POSIX.1-2024): croi's CPRNG
 #elif !defined(__APPLE__)
 
 #include <errno.h>
@@ -81,6 +83,20 @@ void swift_stdlib_random(void *buf, __swift_size_t nbytes) {
   }
 }
 
+#elif defined(__vectraos__)
+
+SWIFT_RUNTIME_STDLIB_API
+void swift_stdlib_random(void *buf, __swift_size_t nbytes) {
+  // At most 256 bytes a call, as POSIX's getentropy allows.
+  while (nbytes > 0) {
+    __swift_size_t n = std::min(nbytes, __swift_size_t{256});
+    if (getentropy(buf, n) != 0)
+      fatalError(0, "Fatal error: getentropy failed in '%s'\n", __func__);
+    buf = static_cast<uint8_t *>(buf) + n;
+    nbytes -= n;
+  }
+}
+
 #else
 
 #undef  WHILE_EINTR
