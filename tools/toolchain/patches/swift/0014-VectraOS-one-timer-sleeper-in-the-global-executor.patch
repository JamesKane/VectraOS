@@ -87,6 +88,13 @@ struct Queue {
   uint32_t port = 0;
   unsigned sleeping = 0; // threads in td_port_wait, or about to be
   unsigned wakes = 0;    // wake packets queued and not yet taken
+  // One sleeper waits for the soonest deadline (the timer sleeper), the
+  // rest for a packet alone, so a deadline wakes one thread, not all of
+  // them (each a migration in croi, then contention here). `timerGen`
+  // names the current holder; bumping it revokes the role (a sooner
+  // deadline came, and a woken sleeper takes the role up with it).
+  bool timerHeld = false;
+  uint64_t timerGen = 0;
   JobList ready[Buckets];
   SwiftJob *delayed = nullptr; // sorted by deadline, soonest first
 
@@ -99,6 +107,20 @@ struct Queue {
       fail("cannot make the executor's port");
   }
 
+  // With the lock held: a sooner deadline. A holder of the timer role
+  // waits for a later one: it's revoked and a sleeper woken to take it up.
+  // Without one, the caller's own thread takes it if it's this queue's
+  // (it's running a job, and comes back here after), else a sleeper does.
+  void newDeadline(bool ownThread) {
+    if (timerHeld) {
+      timerHeld = false;
+      timerGen++;
+      wakeOne();
+    } else if (!ownThread) {
+      wakeOne();
+    }
+  }
+
   // With the lock held: a sleeper woken, if every sleeper's wake isn't
   // already queued.
   void wakeOne() {
@@ -137,9 +159,21 @@ struct Queue {
         makeReady(job);
       }
       for (auto &list : ready)
-        if (SwiftJob *job = pop(list))
+        if (SwiftJob *job = pop(list)) {
+          // Off to run a job with deadlines pending and no one waiting for
