   pthread_mutex_lock(&globalQueue.lock);
   for (;;) {
     SwiftJob *job = globalQueue.take();
@@ -219,7 +260,7 @@ extern "C" SWIFT_CC(swift) void swift_vectraosEnqueueWithDeadline(
   pthread_mutex_lock(&q.lock);
   // A new soonest deadline: a sleeper wakes to sleep until it instead.
   if (q.addDelayed(job, deadline))
