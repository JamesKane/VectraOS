index fd22b379..b1c3ff1c 100644
--- a/stdlib/public/Concurrency/VectraOSGlobalExecutor.cpp
+++ b/stdlib/public/Concurrency/VectraOSGlobalExecutor.cpp
@@ -7,8 +7,9 @@
