-      int64_t deadline = delayed ? deadlineOf(delayed) : INT64_MAX;
+        }
+      // The timer sleeper, if no one is; else wait for a packet alone.
+      int64_t deadline = INT64_MAX;
+      uint64_t gen = 0;
+      if (delayed && !timerHeld) {
+        timerHeld = true;
+        gen = ++timerGen;
+        deadline = deadlineOf(delayed);
+      }
       sleeping++;
       pthread_mutex_unlock(&lock);
       td_port_packet_t packet;
@@ -152,6 +186,8 @@ struct Queue {
       }
       pthread_mutex_lock(&lock);
       sleeping--;
+      if (gen != 0 && gen == timerGen)
+        timerHeld = false;  // still ours: given up, to be taken again
       if (status == 0 && packet.type == 0 && packet.key == 0 && wakes > 0)
         wakes--;
     }
@@ -159,9 +195,14 @@ struct Queue {
 };
 
