#version 450
// vulkan-test's 1D lookup: a table of eight texels, sampled (nearest) at each texel's centre by one invocation, into a buffer.
layout(local_size_x = 8) in;
layout(set = 0, binding = 0) uniform texture1D lut;
layout(set = 0, binding = 1) uniform sampler smp;
layout(set = 0, binding = 2) writeonly buffer Out { vec4 v[]; } o;

void main() {
  uint i = gl_GlobalInvocationID.x;
  o.v[i] = textureLod(sampler1D(lut, smp), (float(i) + 0.5) / 8.0, 0.0);
}
