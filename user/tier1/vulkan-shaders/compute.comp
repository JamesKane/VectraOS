#version 450
// vulkan-test's compute check: out[i] = in[i] * scale + offset + i, over two storage buffers and a push constant.
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) readonly buffer Source { uint v[]; } src;
layout(set = 0, binding = 1) writeonly buffer Target { uint v[]; } dst;
layout(push_constant) uniform Constants { uint scale; uint offset; uint count; } pc;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i < pc.count) dst.v[i] = src.v[i] * pc.scale + pc.offset + i;
}
