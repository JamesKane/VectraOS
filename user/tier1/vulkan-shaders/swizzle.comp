#version 450
#extension GL_EXT_samplerless_texture_functions : require
// vulkan-test's swizzled view: each texel of a 4 by 4 image, fetched through the view the program made of it, into a buffer.
layout(local_size_x = 16) in;
layout(set = 0, binding = 0) uniform texture2D img;
layout(set = 0, binding = 1) writeonly buffer Out { vec4 v[]; } o;

void main() {
  uint i = gl_GlobalInvocationID.x;
  o.v[i] = texelFetch(img, ivec2(i & 3u, i >> 2), 0);
}
