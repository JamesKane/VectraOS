# devmgr (V2 item 7c, D74): the firmware's tables from the boot data,
# ACPI's namespace, PCI over the MCFG's ECAM, the IOMMUs, and a driver host
# for each device a rule binds, given that device's MMIO, I/O ports,
# interrupt and BTI. CMake adds `resource ioport` on amd64, which alone
# has I/O ports, and `resource smc` on arm64, for firmware a board rule
# names; the system resource names the IOMMUs and allocates MSIs.
# kbdfs's kbin and the mouse service's mousein go to each input driver's
# host (D83).
service devmgr
program devmgr
resource mmio
resource irq
resource system
@CROI_DEVMGR_IOPORT@
@CROI_DEVMGR_SMC@
bootdata
mount /dev/kbin kbdfs/kbin
mount /dev/mousein mouse/mousein
programs
export
