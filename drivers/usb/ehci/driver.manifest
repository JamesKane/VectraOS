# SPDX-License-Identifier: BSD-3-Clause
# ehci: an EHCI USB host controller, its hubs, and HID's boot keyboards and
# mice (ehci(3)): on PCI by its class, and the SpacemiT K1's ChipIdea
# controllers, which only the vendor's tree describes (D157). Its schedules
# hold 32-bit addresses.
driver ehci
class usb
match pci-class 0c.03.20
match dt ky,mv-ehci
dma-bits 32
