# API baseline for todhchai.gpu.csf.Context, written by idlc. Commit it; idlc checks changes against it.
protocol todhchai.gpu.csf.Context version 1
struct Buffer (Handle,UInt32,UInt64)
struct GroupState (UInt32,UInt32,Bool)
struct Info (UInt32,UInt32,UInt32,UInt64,UInt64,UInt64,UInt64,UInt32,UInt32,UInt32,UInt32,UInt32,UInt32,UInt32,UInt32,UInt32)
struct Job (UInt32,UInt64,UInt32,UInt32)
struct QueueConfig (UInt32,UInt32)
struct SyncValue (UInt32,UInt64)
struct VMInfo (UInt32,UInt64)
method addSync call since 1 params (Handle) result UInt32 throws GPUError
method bind call since 1 params (UInt32,UInt32,UInt64,UInt64,UInt64,UInt32) result - throws GPUError
method createBuffer call since 1 params (UInt64,UInt32) result Buffer throws GPUError
method createGroup call since 1 params (UInt32,[QueueConfig],UInt32) result UInt32 throws GPUError
method createVM call since 1 params (UInt64) result VMInfo throws GPUError
method destroyBuffer call since 1 params (UInt32) result - throws GPUError
method destroyGroup call since 1 params (UInt32) result - throws GPUError
method destroyVM call since 1 params (UInt32) result - throws GPUError
method groupState call since 1 params (UInt32) result GroupState throws GPUError
method info call since 1 params () result Info throws -
method removeSync call since 1 params (UInt32) result - throws -
method submit call since 1 params (UInt32,[Job],[SyncValue],[SyncValue]) result - throws GPUError
method unbind call since 1 params (UInt32,UInt64,UInt64) result - throws GPUError
