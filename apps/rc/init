# init: the first program, an rc script the kernel runs after its checks.
# The disks are mounted already, and this console -- the serial line, and
# the screen until the draw server takes it -- is descriptors 0, 1 and 2.
#
# The keyboard goes to kbdfs, whose file the draw server reads its keys
# from, so the serial line keeps the kernel's own line discipline for the
# shell below. A machine with no keyboard still gets the window; only the
# serial shell can be typed at there.
kbdfs &
while(! test -e /srv/kbdfs) sleep 1
mount /srv/kbdfs /n/kbd

intuition /n/kbd/kbd &
while(! test -e /srv/draw) sleep 1

# The network: the stack over the card the kernel serves as #E, and /net
# where every program looks for it. A machine with no card has no /srv/net,
# and the mount is skipped rather than waited on for ever.
netfs &
if(test -e /dev/ether0/data) {
	while(! test -e /srv/net) sleep 1
	mount /srv/net /net
	# The names: dns asks the network, and cs turns a dial string into an
	# address out of the database or dns. Both sit beside the stack's tree.
	dns &
	while(! test -e /srv/dns) sleep 1
	mount -a /srv/dns /net
	cs &
	while(! test -e /srv/cs) sleep 1
	mount -a /srv/cs /net
	# An interface the database gave no address asks the network for one.
	# In the background: a link with no router answers nothing, and the
	# boot does not wait on it.
	ipconfig &
	# And this machine serves its tree: `listen` runs `exportfs` for every
	# connection to a port named in `/lib/service`, so another machine can
	# import what this one holds. `docs/FLEET.md` step 1.
	listen &
}

# The keys a session holds: factotum, at /mnt/factotum, empty until a
# passphrase or a host key is written to its ctl. Every handshake a program
# runs goes through it. docs/FLEET.md section 4.
# /mnt becomes a union: the draw server will mount its windows before the
# root's own directory, and a union here holds only what was mounted or
# bound, so the directory is bound onto itself first. That keeps
# /mnt/factotum, a mount point inside it, reachable beside the windows.
bind /mnt /mnt
factotum &
while(! test -e /srv/factotum) sleep 1
mount /srv/factotum /mnt/factotum
# A host is a user too. Its name is the database record its card matched,
# and its key is /adm/hostkey, the private half only this machine carries;
# the public half is on its record as key=. Both go into factotum, and the
# session runs as the host until a person types a passphrase.
dom=home
if(test -e /net/sysname) sysname=`{cat /net/sysname}
if(~ $#sysname 0) sysname=vectra
user=$sysname
if(test -e /adm/hostkey) {
	hostkey=`{cat /adm/hostkey}
	echo key proto=noise user=$sysname dom=$dom '!private='^$hostkey > /mnt/factotum/ctl
}

# A window with a shell in it, the terminal's own child.
terminal &

# A panel of gadgets on sys/libmui, so the desktop shows the toolkit too.
muidemo &

# And this console's shell, which init becomes.
cd $home
exec rc -i
