# init: the first program, an rc script the kernel runs after its checks.
# The disks are mounted already, and this console -- the serial line, and
# the screen until the draw server takes it -- is descriptors 0, 1 and 2.
#
# A machine's role is its `ndb` line, not a build or a flag (docs/FLEET.md
# section 6). `terminal=` starts the keyboard, the screen and the desktop;
# `cpu=` and `fs=` start `listen`, which serves this machine's tree over the
# network. A machine may be more than one: a laptop under QEMU is a terminal
# and a CPU server at once. init reads the roles and starts what they name.

# The namespace is a file: /lib/namespace carries the binds that make a fresh
# process's world -- /bin and its siblings out of the one tree at /n/fs. The
# kernel bound them for its own checks; this replays the file so a process's
# world is data, the same file a diskless machine replays after it imports the
# tree over the network. docs/FLEET.md section 6.
newns /lib/namespace

# The network first, because a machine's name -- and so its roles -- is the
# `ndb` record its card matched, read from /net once the stack can say it. A
# machine with no card has no /srv/net, and the mount is skipped rather than
# waited on for ever.
netfs &
if(test -e /dev/ether0/data) {
	while(! test -e /srv/net) sleep 1
	mount /srv/net /net
	# The names: dns asks the network, and cs turns a dial string into an
	# address out of the database or dns. Both sit beside the stack's tree.
	dns &
	while(! test -e /srv/dns) sleep 1
	mount -a /srv/dns /net
	cs &
	while(! test -e /srv/cs) sleep 1
	mount -a /srv/cs /net
}

# This machine's name: the database record its card matched, read from /net
# once the stack can say it, or `vectra` on a machine with no card.
dom=home
if(test -e /net/sysname) sysname=`{cat /net/sysname}
if(~ $#sysname 0) sysname=vectra
user=$sysname

# A host is a user too. The kernel's word for it is `hostowner` on this
# process's ctl: from here on this process and every process it starts run as
# the host, and the host owner's processes are the ones that may become a
# client they have proved. So it comes before anything that must run as the
# host -- `listen`, whose `exportfs` becomes each client -- and not after.
# `echo` is a program, so the write arrives from a forked child; the kernel
# sets the named process, not the writer, which is why `$pid` names this
# shell. See /proc/n/ctl in proc(3).
echo hostowner $sysname > /proc/$pid/ctl

# The keys a session holds: factotum, at /mnt/factotum, empty until a
# passphrase or a host key is written to its ctl. Every handshake a program
# runs goes through it -- a login on a terminal, a client on a server. So it
# comes before the roles. docs/FLEET.md section 4.
# /mnt becomes a union: the draw server will mount its windows before the
# root's own directory, and a union here holds only what was mounted or
# bound, so the directory is bound onto itself first. That keeps
# /mnt/factotum, a mount point inside it, reachable beside the windows.
bind /mnt /mnt
factotum &
while(! test -e /srv/factotum) sleep 1
mount /srv/factotum /mnt/factotum
# The host's key is /adm/hostkey, the private half only this machine
# carries; the public half is on its record as key=. It goes into factotum
# under the host's name, set above, and the session runs as the host until
# a person types a passphrase.
if(test -e /adm/hostkey) {
	hostkey=`{cat /adm/hostkey}
	echo key proto=noise user=$sysname dom=$dom '!private='^$hostkey > /mnt/factotum/ctl
}

# The root: where this machine's tree comes from. The boot may have told it on
# the kernel command line as root=, seeded into #e as $root. `local` -- or being
# told nothing -- is the disk the kernel already mounted at /n/fs. Anything else
# names a file server: init dials it, mounts its tree at /n/fs over the disk's,
# and replays /lib/namespace so /bin and its siblings come from the server's one
# tree. From there this machine runs its own architecture's tools off another's
# disk -- docs/FLEET.md section 6's diskless boot. The roles below read the tree,
# so the root comes before them; a server it cannot reach leaves it on the disk.
if(~ $#root 0) root=local
if(! ~ $root local) {
	# A diskless machine has nothing to run until it reaches its file server, so
	# it keeps trying: the server may still be booting, or the link still cold.
	# On success the server's own tree, at /n/fs in its namespace, becomes ours
	# at /n/fs, and /lib/namespace binds /bin and its siblings out of it -- the
	# same file a local machine replays.
	imported=no
	for(i in `{seq 30}) if(~ $imported no) {
		if(import $root /n/remote) {
			bind /n/remote/n/fs /n/fs
			newns /lib/namespace
			imported=yes
		}
		if not sleep 1
	}
	if(~ $imported yes) echo init: root over the network, on $root -- /bin is its tree >[1=2]
	if(~ $imported no) echo init: could not reach root $root, using the disk >[1=2]
}

# The terminal role: a keyboard, a screen, and the desktop in the terminal's
# place -- the bar and its menus, the backdrop and its icons. The keyboard
# goes to kbdfs, whose file the draw server reads its keys from, so the serial
# line keeps the kernel's own line discipline for the shell below. Workbench's
# notice service goes at /mnt/wb, so a line from this console draws a toast.
if(role $sysname terminal) {
	kbdfs &
	while(! test -e /srv/kbdfs) sleep 1
	mount /srv/kbdfs /n/kbd

	intuition /n/kbd/kbd &
	while(! test -e /srv/draw) sleep 1

	workbench &
	while(! test -e /srv/wb) sleep 1
	mount /srv/wb /mnt/wb
}

# The server roles: a CPU server or a file server serves its tree to another
# machine, so both need the card and both start `listen`, which runs
# `exportfs` for every connection to a port named in /lib/service. Started as
# the host, above, so each `exportfs` may become the client it proves. The
# file server's `kfs` is already up, started by the kernel on the disk it
# found; the fs role's work here is to serve it. docs/FLEET.md section 6.
if(test -e /dev/ether0/data) {
	# An interface the database gave no address asks the network for one.
	# In the background: a link with no router answers nothing, and the
	# boot does not wait on it.
	ipconfig &
	if(role $sysname cpu || role $sysname fs) listen &
}

# And this console's shell, which init becomes.
cd $home
exec rc -i
