# /lib/ghost/ns/post: a task that may post, docs/WEB.md section 10. It
# is to be `social` with each network's `new` reachable behind the
# requester: a write to `new` asks the person first. That requester is
# not built yet, so until it is this class is `social`, read only, and a
# task that talks the model into posting finds a refusal, not a post.
bind /n/fs/$cputype/bin /bin
bind /mnt/plumb /mnt/plumb
bind -r /mnt/feed /mnt/feed
bind -r /mnt/mail /mnt/mail
bind -r /mnt/matrix /mnt/matrix
bind -r /mnt/fedi /mnt/fedi
bind -r /mnt/at /mnt/at
bind -r /mnt/mention /mnt/mention
