# neon: the chrome study's default: violet panels over a near-black void, neon as signal.
# A scheme from docs/CHROME.md section 3: the colours by name, then the
# roles by job. `use neon` in $home/lib/theme picks it.

colour void      0a0a18
colour panel     1b1535
colour raised    2a2150
colour well      110d24
colour edge      000000
colour text      e8e6ff
colour dim       a49cd6
colour mag       ff2bd6
colour cyan      00e5ff
colour amber     ffb000
colour green     39ff14
colour red       ff3b5c
colour violet    9d5cff
colour violet.lit b28aff   # link text: the study's violet fails 4.5 on raised
colour metal.hi  4a4178
colour metal.lo  211a40
colour bevel.hi  594e82
colour bevel.lo  0a0814
colour lcd.bg    1d1405
colour lcd.fg    ffb000

font.chrome     /lib/font/chrome/11.face  track 1 caps   # buttons, titles, legends
font.interface  /lib/font/interface/13.face   # labels
font.readout    /lib/font/readout/20.face     # LCD readouts
font.namespace  /lib/font/namespace/12.face   # paths and status lines

frame.style metal         # a brushed bar, a focus line on the front one
icons       /lib/icons    # the study's drawn icons, docs/CHROME.md section 6
lcd.bg      lcd.bg        # the readout's glass and lit segments, docs/CHROME.md section 10
lcd.fg      lcd.fg
lcd.ghost   13            # the unlit segments, in parts in 100
frame.edge  1
frame.title 24
frame.well  1
glow        60              # the front window's halo, per cent
shadow      6               # a shadow under every window, in pixels

panel       panel           # a window's body
raised      raised          # a control's face
face.lit    bevel.hi        # its top-left edge
face.shade  bevel.lo        # its bottom-right edge
text        text
dim         dim
accent      mag             # the selection, the default button
focus       cyan            # the active window, the focus ring
warn        amber
ok          green
fault       red
link        violet.lit
bar         metal.hi        # the title bar's metal
bar.lit     bevel.hi
bar.shade   metal.lo
plinth.lit  bevel.hi        # the frame's raised border
plinth.shade bevel.lo
desk neon dots void raised 24
desk.ground neon
