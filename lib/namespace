# namespace: the binds a fresh process starts from, docs/FLEET.md step 3.
# `newns` in sys/libuser replays these, expanding $cputype from #e -- the same
# `bind`/`mount` lines `ns` prints, so a rebuilt namespace matches a described
# one. A machine binds its own architecture's tools over /bin.
#
# The source is where the tree sits today: mounted under /n/esp. When the file
# server's tree is the root (docs/FLEET.md step 3's diskless boot), /amd64 and
# its siblings are top-level and this becomes `bind /$cputype/bin /bin`.
bind /n/esp/vectra/$cputype/bin /bin
