# lib/vx-rt/sysroot/llvm-libc.ndb: the C library the native target's sysroot
# takes (ADR-0033 §1, M6 step 6e2b): llvm-libc, built by swift-on-vectra's
# toolchain/build_libc.sh from its pinned llvm-project with LLVM patch 0004,
# until ADR-0034's first gate puts the toolchain in this tree. ./build looks
# for it in $VECTRA_SWIFT_ON_VECTRA (by default ../../lang/swift-on-vectra
# from this tree), under toolchain/out/libc/TRIPLE, and refuses a build whose
# tree hash (as tree.sha256 is computed in third_party: find . -type f |
# sort | sha256sum, hashed) differs from the one recorded here: a new build
# is taken by recording it.

triple=x86_64-unknown-vectraos llvm-project=903b9faaae5c43ecc9b7e33f8db9c94c7429374a
    patches=0001-0009
    tree.sha256=e1b6c83c4b278326750173ee8edf233dd03a9549ce84210a7077a0a59d2e7b31

triple=aarch64-unknown-vectraos llvm-project=903b9faaae5c43ecc9b7e33f8db9c94c7429374a
    patches=0001-0009
    tree.sha256=2a4f3df13ea949231b1bf62039faac9bebd6ea3791f11f04fff0658b9e184ae9
