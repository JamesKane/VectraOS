# The client the boot runs to its end (launcher.until=launch-test); CMake
# adds `use time` where the time service runs (amd64). `programs`: it
# starts rc (tier 1: amd64 and arm64) to run `cat /svc/*/status`, and runs
# it on a terminal of its own; /bin is the bootfs service's (D71).
# /dev is kbdfs's, the mouse service's, then devmgr's device directories
# (D82, D83); the manual is the volume's lib/man before bootfs's (D86,
# D105), which rc's man reads.
# Its /env from its `env` lines, and /svc/env for rc's groups (D81).
# /proc is proc's (D79); /net, devmgr's ether(3) directories (D82),
# then net's protocols, cs and dns (D79). 9gate at /svc (D77, D78).
# /data is fs's volume, on the virtio disk's taisce partition (D105), at
# /svc too, to find the volume again after fs restarts (D8).
# The console at /mnt/console, not /svc: its status changes as the log
# grows, which `cat /svc/*/status` would race.
service launch-test
program launch-test
use a
use b
use devmgr
use net
use cs
use dns
use 9gate
use fs
use env
env LAUNCH_TEST=yes
mount /bin bootfs/bin
mount /lib/man bootfs/lib/man
mount /lib/man fs/volume/lib/man before optional
mount /dev kbdfs
mount /dev mouse after
mount /dev devmgr/dev after
mount /net devmgr/net
mount /net net/net after
mount /net cs/net after
mount /net dns/net after
mount /mnt/console console
mount /mnt/plumb plumber
mount /dev/kprint console/kprint
mount /proc proc
mount /data fs/volume create
launcher
programs
@CROI_LAUNCH_TEST_USES@
