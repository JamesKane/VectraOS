// The ABI headers shared with user space (user/include/croi/syscall.h
// includes them), a module of their own so user Swift code can import
// them without the kernel's private ones. Tier 1's sysroot carries them
// (cmake/sysroot.cmake), where C before C23 includes them too (the Swift
// runtime's shims): their layout checks are _Static_assert, which C11 to
// C23 and C++ all take, not C23's static_assert.
module CroiAbi {
  header "object.h"
  header "task.h"
  header "ipc.h"
  header "log.h"
  header "processargs.h"
  header "trace.h"
  header "pmu.h"
  header "shared.h"
  header "time.h"
  header "profile.h"
  header "resource.h"
  header "vmo.h"
  header "zbi.h"
  header "interrupt.h"
  header "dma.h"
  header "counter.h"
  header "power.h"
  header "account.h"
  header "port.h"
  export *
}

module CKernel {
  header "kernel.h"
  header "stack.h"
  header "smp.h"
  header "irq.h"
  header "thread.h"
  header "xstate.h"
  header "aspace.h"
  header "usercopy.h"
  header "cache.h"
  header "jit.h"
  header "user.h"
  header "abi.h"
  export *
}
