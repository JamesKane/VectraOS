# Neon Tab: todhchai's look (its desktop.md §6 and shell storyboard),
# which D24 replaced as the default, kept as a theme. A dark theme of
# glow and chamfered cuts, four typefaces, labels uppercase and tracked.
# Its parts are the storyboard's, converted from its cqw (12.8 logical
# pixels) and translated from todhchai's UICore (ui/core/lib/Theme.swift
# at 527ff94): resolved, they are the styles that code built, which
# ThemesTests checks (ui/theme/tests/neon-tab.styles).
#
# The format is theme(6). A copy that inherits from this one and changes
# a few roles is a new theme; a layer of roles alone restyles it.
theme=neon-tab title="Neon Tab" inherits=base version=1
	author="todhchai's storyboard, ported" licence=BSD-3-Clause

# The storyboard's tokens, by role: bg.0 and bg.1 are the desk and the
# chrome, `edge` the outline, `dim` the dimmed ink.
role=desk color=0x0a0a12
role=chrome color=0x12121e
role=ink color=0xd8e1ff
role=ink.dim color=0x8b93b8
role=outline color=0x2c2c46
# A control's edge, at least 3:1 against both grounds, where the
# storyboard's edge is 1.46:1.
role=control color=0x5c607f
# Its neons, its rules' line, and the focus glow (cyan at 55%), the
# theme's own: apps never see them.
role=neon.cyan color=0x00e5ff
role=neon.magenta color=0xff2bd6
role=neon.amber color=0xffb000
role=neon.phosphor color=0x39ff88
role=neon.line color=0x24243a
role=neon.glow color=neon.cyan@55

# The rest of the required roles, from those.
role=chrome.behind color=chrome
role=well color=desk
role=menu color=chrome
role=panel color=chrome
role=bevel.light color=outline
role=bevel.dark color=outline
role=ink.disabled color=neon.line
role=ink.on-select color=desk
role=ink.on-focus color=desk
role=focus color=neon.amber
role=selection color=neon.magenta
role=live color=neon.phosphor
role=alert color=neon.magenta
role=warning color=neon.amber
role=realtime color=neon.cyan
role=lcd color=desk
role=lcd.ink color=neon.phosphor
role=lamp.local color=neon.phosphor
role=lamp.agent color=neon.cyan
role=lamp.egress color=neon.magenta
role=lamp.swarm color=neon.amber

# Chakra Petch for display, IBM Plex Sans for running text, IBM Plex
# Mono for data, Barlow Condensed for the UI's labels.
