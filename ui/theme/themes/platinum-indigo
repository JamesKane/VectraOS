# Platinum Indigo: the system's default look, the storyboard's (its
# component kit frame, docs/design/storyboard/Kit.dc.html). Be's
# structure, NeXT's bevels, SGI Indigo Magic's colour, MUI's groups. Light
# from the top left: raised means it can be pressed, inset that it holds
# data, grooved that it groups. Yellow is the focused window, blue the
# selection, green on black what is live.
#
# The format is theme(6). A copy that inherits from this one and changes
# a few roles is a new theme; a layer of roles alone restyles it.
theme=platinum-indigo title="Platinum Indigo" inherits=base version=1
	author="the VectraOS storyboard" licence=BSD-3-Clause

# The kit frame's tokens.
role=desk color=0x3f5868
role=chrome color=0xd8d4cb
role=chrome.behind color=0xcdc9bf
role=well color=0xfbfaf6
role=menu color=0xefece6
role=panel color=0xd8d4cb
role=outline color=0x2b2618
role=bevel.light color=0xf9f7f1
role=bevel.dark color=0x8f8a7f
# A control's edge, a field's or a well's.
role=control color=0x6d685e
role=ink color=0x1d1b17
role=ink.dim color=0x4a463e
role=ink.disabled color=0x8f8a7f
role=ink.on-select color=0xffffff
# The selection is the accent, a knob (D108): the storyboard's blue, a
# teal or a plum, each dark enough for white text on it.
knob=accent type=role default=accent.theme suggest=accent.theme,accent.cool,accent.warm label="Accent"
role=accent.theme color=0x3e6fb0
role=accent.cool color=0x1f6b70
role=accent.warm color=0x7a3e8c
role=selection color=$accent
role=lcd color=0x14211d
role=lcd.ink color=0x9cf28f
# The focused tab's yellow, and its lit and shaded ends, the theme's own.
role=tab.focus color=0xf2bb26
role=tab.focus.light color=0xffe48a
role=tab.focus.dark color=0xb38710
# A button's face, a tab behind and the scrollbar's track and thumb.
role=face color=0xece9e2
role=track color=0xc9c5bb
role=thumb color=0xe0ddd5
# Focus outside the tab (a field's edge, a focus ring) is the yellow
# darkened to 3:1 on the chrome; the storyboard's red is darkened so too,
# for alert and realtime alike.
role=focus color=0x8a5e00
role=ink.on-focus color=0xffffff
role=alert color=0xb3362b
role=realtime color=0xb3362b
role=live color=0x17703a
role=warning color=0x865400
role=lamp.local color=0x17703a
role=lamp.agent color=0x6a3c9e
role=lamp.egress color=0xb3362b
role=lamp.swarm color=0x2b56b8

# Archivo: expanded for display, a little narrowed for the UI's titles,
# menus and labels; IBM Plex Mono for the terminal, readouts and data.
typeface=display family="Archivo" weight=800 width=125
typeface=body family="Archivo" weight=400 width=100
typeface=mono family="IBM Plex Mono" weight=400
typeface=ui family="Archivo" weight=600 width=92

# The parts the kit frame draws; the rest are the base theme's, in these
# roles.
part=default fill=chrome ink=ink size=13 lineheight=1.3
part=desktop fill=desk ink=0xffffff
part=desktop.icon.selected fill=selection ink=ink.on-select radius=2
part=window.tab fill=chrome.behind stroke=outline ink=ink.dim border=1
	radius=5 weight=700 size=13 padding=0,6,0,6
	gradient=face,chrome.behind angle=90 bevel=raised
part=window.tab.focused fill=tab.focus ink=ink
	gradient=tab.focus.light,tab.focus angle=90
part=window.body fill=chrome stroke=outline border=1 radius=3
	padding=3,3,3,3 bevel=raised
part=window.body.focused stroke=outline
part=menubar fill=menu stroke=bevel.dark border=1
	gradient=0xf3f1eb,0xdcd8cf angle=90
# A menu that opens: square, its shadow solid, down and to the right.
part=menu fill=menu stroke=ink border=1 shadow=0x00000040 shadowoffset=3,3
	blur=0
part=menu.key font=mono weight=400 size=11.5
part=menu.rule fill=0xa7a296 ink=0xa7a296
part=menu.item fill=none padding=3,10,3,10
part=menu.item.hot fill=selection ink=ink.on-select
part=button fill=face stroke=outline border=1 radius=4 weight=600
	size=12.5 padding=0,14,0,14 gradient=well,0xd6d2c8 angle=90 bevel=raised
part=button.primary stroke=outline border=2
part=toggle fill=well stroke=outline border=1 bevel=inset
part=toggle.on fill=well ink=ink
part=field fill=0xffffff stroke=control border=1 font=body weight=400
	size=12.5 padding=0,7,0,7 bevel=inset
part=field.focused stroke=focus
part=group fill=none border=0 radius=4 bevel=groove
	padding=8,10,10,10
part=group.legend fill=none weight=700 size=12.5
part=scrollbar fill=track stroke=control border=1 pattern=stripes
	patterncolors=0xc9c5bb,0xbdb8ad pitch=4
part=scrollbar.thumb fill=thumb stroke=0x57524a radius=2
	gradient=0xf3f1eb,0xd0ccc2 angle=0 bevel=raised
part=lcd fill=lcd stroke=0x57524a ink=lcd.ink border=1 font=mono
	bevel=inset
part=heading fill=none font=ui weight=800 size=13 tracking=0.08 case=upper
	ink=0x3a372f
part=deskbar fill=panel stroke=outline border=1 bevel=raised
part=deskbar.row fill=none padding=0,10,0,10

# The kit frame's other controls: checks and radios hold data, so are
# inset; the pop-up and the slider's knob are pressed, so raised.
part=check fill=well stroke=outline border=1 bevel=inset
part=check.on ink=ink
part=radio fill=well stroke=outline border=1 radius=7 bevel=inset
part=radio.on ink=selection
part=popup fill=face stroke=outline border=1 radius=3 weight=400
	size=12.5 padding=0,6,0,9 gradient=well,0xd6d2c8 angle=90 bevel=raised
part=slider fill=chrome stroke=0x57524a border=1 radius=3
	gradient=0xa7a296,chrome angle=90
part=slider.fill fill=selection ink=selection stroke=0x1d2b3a border=1
	radius=3
	gradient=0x5d8fd0,selection angle=90
part=slider.knob fill=thumb stroke=ink border=1 radius=3
	gradient=well,0xd0ccc2 angle=0 bevel=raised
part=progress fill=menu stroke=ink border=1 bevel=inset
part=progress.bar fill=selection ink=selection pattern=stripes
	patterncolors=selection,0x5d8fd0 pitch=12
part=tabs.tab fill=chrome.behind stroke=control border=1 radius=4 size=12
	weight=400 padding=4,10,4,10
part=tabs.tab.on fill=menu weight=700
part=scrollbar.arrow fill=face stroke=control border=1
	gradient=0xf3f1eb,0xcfcbc1 angle=90 bevel=raised

# High contrast: the base theme's, with the theme's own roles to match.
# The focused tab stays yellow, its title black.
variant=high-contrast title="Platinum Indigo, high contrast"
	role=tab.focus color=0xffff00
	role=tab.focus.light color=0xffff00
	role=tab.focus.dark color=0xffff00
	role=face color=0x000000
	role=track color=0x000000
	role=thumb color=0x000000
	part=window.tab.focused ink=ink.on-focus
	# The gradients name colours, not roles: flat in high contrast, as
	# the base theme's parts are, and the field is a well.
	part=window.tab gradient=none
	part=menubar gradient=none
	part=button gradient=none
	part=popup gradient=none
	part=scrollbar pattern=none
	part=scrollbar.thumb gradient=none
	part=scrollbar.arrow gradient=none
	part=slider gradient=none
	part=slider.fill gradient=none
	part=slider.knob gradient=none
	part=field fill=well
